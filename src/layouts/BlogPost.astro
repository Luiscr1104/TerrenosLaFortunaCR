---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, excerpt, image, date, readingTime } = Astro.props;
---

<Layout
    title={title}
    description={excerpt}
    image={image}
    articleSchema={true}
    ogType="article"
>
    <!-- Progress Bar -->
    <div class="fixed top-0 left-0 right-0 h-1.5 bg-neutral-100 z-50">
        <div
            class="h-full bg-[color:var(--gold)] origin-left scale-x-0 transition-transform duration-100"
            id="progress-bar"
        >
        </div>
    </div>

    <article class="bg-white pb-24 pt-32 sm:pt-40 relative overflow-hidden">
        <!-- Background elements -->
        <div
            class="absolute top-0 inset-x-0 h-[500px] bg-gradient-to-b from-neutral-50 to-white -z-10"
        >
        </div>
        <div
            class="absolute top-20 right-0 w-[600px] h-[600px] bg-[color:var(--gold)]/5 rounded-full blur-[100px] -z-10 pointer-events-none"
        >
        </div>
        <div
            class="absolute top-40 left-0 w-[400px] h-[400px] bg-[color:var(--forest)]/5 rounded-full blur-[80px] -z-10 pointer-events-none"
        >
        </div>

        <div class="mx-auto max-w-4xl px-6 lg:px-8">
            <!-- Back Link -->
            <div class="mb-8 text-center sm:text-left">
                <a
                    href="/blog"
                    class="inline-flex items-center gap-2 text-sm font-medium text-neutral-500 hover:text-[color:var(--forest)] transition-colors group"
                >
                    <svg
                        class="w-4 h-4 transition-transform group-hover:-translate-x-1"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Back to Articles
                </a>
            </div>

            <div class="mx-auto max-w-3xl text-center">
                <div
                    class="flex flex-wrap items-center justify-center gap-4 text-sm mb-6"
                >
                    <time
                        datetime={date.toISOString()}
                        class="flex items-center gap-1.5 text-neutral-500 font-medium"
                    >
                        <svg
                            class="w-4 h-4 text-[color:var(--gold)]"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                            ></path>
                        </svg>
                        {
                            date.toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            })
                        }
                    </time>
                    {
                        readingTime && (
                            <>
                                <span class="text-neutral-300">•</span>
                                <span class="flex items-center gap-1.5 text-neutral-500 font-medium">
                                    <svg
                                        class="w-4 h-4 text-[color:var(--gold)]"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                        />
                                    </svg>
                                    {readingTime}
                                </span>
                            </>
                        )
                    }
                </div>

                <h1
                    class="text-3xl md:text-4xl lg:text-5xl font-display font-bold tracking-tight text-neutral-900 mb-8 leading-tight"
                >
                    {title}
                </h1>

                <p
                    class="text-lg md:text-xl leading-relaxed text-neutral-600 font-medium max-w-2xl mx-auto"
                >
                    {excerpt}
                </p>
            </div>

            <div
                class="mt-12 sm:mt-16 relative aspect-[16/9] w-full overflow-hidden rounded-3xl shadow-2xl"
            >
                <img
                    src={image}
                    alt={title}
                    class="h-full w-full object-cover transform hover:scale-105 transition-transform duration-700"
                />
                <div
                    class="absolute inset-0 ring-1 ring-inset ring-black/10 rounded-3xl"
                >
                </div>
            </div>

            <div
                class="mt-16 max-w-4xl mx-auto prose prose-lg md:prose-xl prose-slate
        selection:bg-[color:var(--gold)] selection:text-white
        prose-headings:font-display prose-headings:font-bold prose-headings:text-[color:var(--forest)] prose-headings:tracking-tight prose-headings:leading-tight prose-headings:scroll-mt-20
        prose-p:text-neutral-800 prose-p:leading-[2.0] prose-p:font-normal prose-p:tracking-wide prose-p:mb-10
        prose-a:text-[color:var(--forest)] prose-a:font-bold prose-a:no-underline hover:prose-a:text-[color:var(--gold)] prose-a:transition-colors prose-a:border-b-2 prose-a:border-[color:var(--gold)]/30 hover:prose-a:border-[color:var(--gold)]
        prose-strong:text-neutral-900 prose-strong:font-black
        prose-blockquote:border-l-8 prose-blockquote:border-[color:var(--gold)] prose-blockquote:bg-neutral-50 prose-blockquote:py-8 prose-blockquote:px-10 prose-blockquote:rounded-r-2xl prose-blockquote:not-italic prose-blockquote:text-neutral-700 prose-blockquote:font-bold prose-blockquote:text-2xl prose-blockquote:leading-relaxed prose-blockquote:shadow-md prose-blockquote:my-12
        prose-img:rounded-[2rem] prose-img:shadow-xl prose-img:my-12 prose-img:w-full prose-img:object-cover prose-img:aspect-video
        prose-li:marker:text-[color:var(--gold)] prose-li:text-neutral-800 prose-li:my-4 prose-li:leading-relaxed
        prose-ul:my-10 prose-ol:my-10
        first-letter:text-7xl first-letter:font-black first-letter:text-[color:var(--forest)] first-letter:mr-5 first-letter:float-left first-letter:font-display first-letter:leading-[0.8]"
            >
                <slot />
            </div>

            <!-- Share Section -->
            <div class="mt-20 pt-10 border-t border-neutral-200">
                <div
                    class="flex flex-col sm:flex-row items-center justify-between gap-6"
                >
                    <div class="text-center sm:text-left">
                        <h3
                            class="text-lg font-display font-bold text-neutral-900"
                        >
                            Share this article
                        </h3>
                        <p class="text-sm text-neutral-500">
                            Help others find this guide
                        </p>
                    </div>
                    <div class="flex gap-3">
                        <button
                            class="share-btn bg-[#1877F2] text-white p-2.5 rounded-full hover:brightness-110 transition shadow-sm"
                            data-platform="facebook"
                            aria-label="Share on Facebook"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                                ></path></svg
                            >
                        </button>
                        <button
                            class="share-btn bg-[#1DA1F2] text-white p-2.5 rounded-full hover:brightness-110 transition shadow-sm"
                            data-platform="twitter"
                            aria-label="Share on Twitter"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
                                ></path></svg
                            >
                        </button>
                        <button
                            class="share-btn bg-[#25D366] text-white p-2.5 rounded-full hover:brightness-110 transition shadow-sm"
                            data-platform="whatsapp"
                            aria-label="Share on WhatsApp"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.96 9.96 0 0 0 1.332 4.993L2 22l5.083-1.334a9.96 9.96 0 0 0 4.928 1.317h.004a9.99 9.99 0 0 0 9.99-9.982C22.002 6.666 17.522 2 12.012 2zm0 18.288h-.004a8.27 8.27 0 0 1-4.22-1.157l-.302-.18-3.138.823.838-3.058-.196-.313a8.28 8.28 0 0 1-1.27-4.417c.002-4.57 3.725-8.287 8.29-8.287 2.214 0 4.295.863 5.86 2.428a8.26 8.26 0 0 1 2.433 5.865c-.003 4.568-3.725 8.286-8.29 8.296zm4.538-6.205c-.248-.124-1.472-.726-1.7-.81-.226-.082-.392-.123-.556.124-.166.248-.642.81-.787.974-.144.166-.29.186-.537.062-.248-.125-1.047-.386-1.994-1.23-1.74-1.55-2.07-2.48-2.31-2.88-.23-.39-.18-.56.05-.78.21-.19.46-.49.69-.74.23-.25.3-.42.45-.7.15-.27.07-.52-.04-.73-.11-.2-.56-2.28-.99-2.67-.3-.26-.64-.23-.87-.23-.23 0-.5.08-.76.36-.26.29-1 .98-1 2.38s1.02 2.76 1.16 2.95c.14.19 2 3.06 4.85 4.29 2.84 1.23 2.84.82 3.36.76.51-.06 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.16-.48-.28z"
                                ></path></svg
                            >
                        </button>
                        <button
                            class="share-btn bg-neutral-800 text-white p-2.5 rounded-full hover:brightness-125 transition shadow-sm"
                            data-platform="copy"
                            aria-label="Copy Link"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                                ></path></svg
                            >
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </article>

    <script>
        // Progress bar
        window.addEventListener("scroll", () => {
            const winScroll =
                document.body.scrollTop || document.documentElement.scrollTop;
            const height =
                document.documentElement.scrollHeight -
                document.documentElement.clientHeight;
            const scrolled = winScroll / height;
            const progressBar = document.getElementById("progress-bar");
            if (progressBar) {
                progressBar.style.transform = `scaleX(${scrolled})`;
            }
        });

        // Share buttons
        document.querySelectorAll(".share-btn").forEach((btn) => {
            btn.addEventListener("click", async () => {
                const platform = btn.getAttribute("data-platform");
                const url = window.location.href;
                const title = document.title;

                if (platform === "facebook") {
                    window.open(
                        `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
                        "_blank",
                    );
                } else if (platform === "twitter") {
                    window.open(
                        `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`,
                        "_blank",
                    );
                } else if (platform === "whatsapp") {
                    window.open(
                        `https://wa.me/?text=${encodeURIComponent(title + " " + url)}`,
                        "_blank",
                    );
                } else if (platform === "copy") {
                    try {
                        await navigator.clipboard.writeText(url);
                        const originalHTML = btn.innerHTML;
                        btn.innerHTML =
                            '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
                        setTimeout(() => {
                            btn.innerHTML = originalHTML;
                        }, 2000);
                    } catch (err) {
                        console.error("Failed to copy", err);
                    }
                }
            });
        });
    </script>

    <style>
        :root {
            --gold: #d4af37;
            --forest: #052e14;
        }
    </style>
</Layout>
