---
const cells = [
  {
    src: "/salto.webp",
    alt: "Waterfall in the La Fortuna rainforest, Costa Rica",
    label: "LA FORTUNA · COSTA RICA",
    quote: "The waterfall that\nchanges everything.",
    cls: "cell-salto",
    textPos: "bottom-left",
  },
  {
    src: "/images/Lapa.webp",
    alt: "Scarlet macaw in Costa Rica jungle near Arenal Volcano",
    label: "400+ BIRD SPECIES",
    quote: null,
    cls: "cell-lapa",
    textPos: "top-left",
  },
  {
    src: "/sun.webp",
    alt: "Golden sunset over La Fortuna, Arenal region Costa Rica",
    label: "YEAR-ROUND SUNSHINE",
    quote: null,
    cls: "cell-sun",
    textPos: "bottom-right",
  },
  {
    src: "/images/rana.webp",
    alt: "Red-eyed tree frog on a leaf in the Costa Rica rainforest",
    label: "WILDLIFE SANCTUARY",
    quote: null,
    cls: "cell-rana",
    textPos: "bottom-left",
  },
  {
    src: "/castor.webp",
    alt: "Nature and wildlife in the jungle near Arenal Volcano",
    label: null,
    quote: null,
    cls: "cell-castor",
    textPos: "bottom-left",
  },
  {
    src: "/images/catarata.webp",
    alt: "La Fortuna waterfall, one of Costa Rica's most spectacular",
    label: "LA FORTUNA WATERFALL",
    quote: null,
    cls: "cell-catarata",
    textPos: "bottom-left",
  },
  {
    src: "/sanrafael.webp",
    alt: "San Rafael valley panoramic view, La Fortuna de San Carlos",
    label: "SAN RAFAEL · LA FORTUNA",
    quote: "Own the land\nwhere it all lives.",
    cls: "cell-sanrafael",
    textPos: "bottom-left",
  },
  {
    src: "/797.webp",
    alt: "Lush rainforest and nature in the Arenal region, Costa Rica",
    label: null,
    quote: null,
    cls: "cell-797",
    textPos: "bottom-right",
  },
];
---

<section class="nm-section" aria-label="La Fortuna nature and wildlife gallery">
  <div class="nm-grid">
    {cells.map((cell) => (
      <div class={`nm-cell ${cell.cls}`}>
        <img
          src={cell.src}
          alt={cell.alt}
          loading="lazy"
          decoding="async"
          class="nm-img"
        />

        <!-- Dark gradient overlay — always present, dims on hover -->
        <div class="nm-overlay" />

        <!-- Text content -->
        {(cell.label || cell.quote) && (
          <div class={`nm-text nm-text--${cell.textPos}`}>
            {cell.label && (
              <span class="nm-label">{cell.label}</span>
            )}
            {cell.quote && (
              <p class="nm-quote">{cell.quote}</p>
            )}
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  /* ── Grid ──────────────────────────────────────────────── */
  .nm-section {
    width: 100%;
    overflow: hidden;
    background: #0d2218;
  }

  .nm-grid {
    display: grid;
    gap: 3px;
    background: #0a1a10;

    /* Desktop: 12-col layout */
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: 56vh 42vh 38vh;
  }

  /* ── Cell placement (desktop) ──────────────────────────── */
  .cell-salto     { grid-column: 1 / 7;  grid-row: 1; }
  .cell-lapa      { grid-column: 7 / 10; grid-row: 1; }
  .cell-sun       { grid-column: 10 / 13; grid-row: 1; }

  .cell-rana      { grid-column: 1 / 5;  grid-row: 2; }
  .cell-castor    { grid-column: 5 / 9;  grid-row: 2; }
  .cell-catarata  { grid-column: 9 / 13; grid-row: 2; }

  .cell-sanrafael { grid-column: 1 / 8;  grid-row: 3; }
  .cell-797       { grid-column: 8 / 13; grid-row: 3; }

  /* ── Cell base ─────────────────────────────────────────── */
  .nm-cell {
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  .nm-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.04);
    transition: transform 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }

  .nm-cell:hover .nm-img {
    transform: scale(1.12);
  }

  /* ── Overlay ───────────────────────────────────────────── */
  .nm-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(8, 24, 14, 0.75) 0%,
      rgba(8, 24, 14, 0.15) 50%,
      rgba(8, 24, 14, 0.05) 100%
    );
    transition: background 0.5s ease;
    z-index: 1;
  }

  .nm-cell:hover .nm-overlay {
    background: linear-gradient(
      to top,
      rgba(8, 24, 14, 0.6) 0%,
      rgba(8, 24, 14, 0.05) 60%,
      transparent 100%
    );
  }

  /* ── Text ──────────────────────────────────────────────── */
  .nm-text {
    position: absolute;
    z-index: 2;
    padding: 20px 22px;
    max-width: 90%;
  }

  .nm-text--bottom-left  { bottom: 0; left: 0; }
  .nm-text--bottom-right { bottom: 0; right: 0; text-align: right; }
  .nm-text--top-left     { top: 0; left: 0; }
  .nm-text--top-right    { top: 0; right: 0; text-align: right; }

  .nm-label {
    display: block;
    font-family: var(--font-sans, 'Inter', system-ui);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: #C9A24E;
    text-transform: uppercase;
    margin-bottom: 6px;
    opacity: 0.9;
  }

  .nm-quote {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(1.2rem, 2.2vw, 1.85rem);
    font-weight: 700;
    font-style: italic;
    color: #fff;
    line-height: 1.15;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.7);
    white-space: pre-line;
    margin: 0;
    transform: translateY(4px);
    transition: transform 0.4s ease;
  }

  .nm-cell:hover .nm-quote {
    transform: translateY(0);
  }

  /* ── Tablet ────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .nm-grid {
      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: 45vh 38vh 35vh 35vh;
    }
    .cell-salto     { grid-column: 1 / 5; grid-row: 1; }
    .cell-lapa      { grid-column: 5 / 7; grid-row: 1; }
    .cell-sun       { grid-column: 1 / 3; grid-row: 2; }
    .cell-rana      { grid-column: 3 / 5; grid-row: 2; }
    .cell-castor    { grid-column: 5 / 7; grid-row: 2; }
    .cell-catarata  { grid-column: 1 / 3; grid-row: 3; }
    .cell-sanrafael { grid-column: 3 / 7; grid-row: 3; }
    .cell-797       { grid-column: 1 / 7; grid-row: 4; }
  }

  /* ── Mobile ────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .nm-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(5, 48vw);
    }
    .cell-salto     { grid-column: 1 / 3; grid-row: 1; }
    .cell-lapa      { grid-column: 1 / 2; grid-row: 2; }
    .cell-sun       { grid-column: 2 / 3; grid-row: 2; }
    .cell-rana      { grid-column: 1 / 2; grid-row: 3; }
    .cell-castor    { grid-column: 2 / 3; grid-row: 3; }
    .cell-catarata  { grid-column: 1 / 2; grid-row: 4; }
    .cell-797       { grid-column: 2 / 3; grid-row: 4; }
    .cell-sanrafael { grid-column: 1 / 3; grid-row: 5; }
    .nm-quote { font-size: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nm-img { transition: none; transform: scale(1); }
    .nm-quote { transition: none; transform: none; }
  }
</style>
