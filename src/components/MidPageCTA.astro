---
import WhatsappIcon from "./WhatsappIcon.astro";
---

<section class="cta-section relative overflow-hidden" aria-label="Book a free consultation">
  <!-- Parallax nature background — catarata waterfall -->
  <div class="cta-bg absolute inset-0 will-change-transform" style="transform: scale(1.15);">
    <img
      src="/salto.webp"
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover object-center"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Deep cinematic overlays -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#0d2218]/90 via-[#0a1c12]/80 to-[#0d2218]/90 pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(201,162,78,0.06)_0%,transparent_65%)] pointer-events-none"></div>

  <!-- Decorative top + bottom hairlines -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#C9A24E]/50 to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#C9A24E]/50 to-transparent"></div>

  <div class="relative z-10 mx-auto max-w-4xl px-6 text-center py-24 md:py-32">
    <!-- Eyebrow -->
    <div class="flex items-center justify-center gap-3 mb-6">
      <div class="h-px w-10 bg-[#C9A24E]/50"></div>
      <span
        class="text-[#C9A24E] text-xs tracking-[0.3em] uppercase font-medium"
        style="font-family: var(--font-sans, Inter, system-ui);"
      >
        Take the First Step
      </span>
      <div class="h-px w-10 bg-[#C9A24E]/50"></div>
    </div>

    <!-- Main headline — large italic serif -->
    <h2
      class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold italic text-white leading-[1.05] tracking-tight mb-6"
      style="font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif); text-shadow: 0 2px 32px rgba(0,0,0,0.6);"
    >
      Your chapter in Costa Rica<br class="hidden sm:block" />
      <span class="text-[#C9A24E]"> begins with one conversation.</span>
    </h2>

    <!-- Sub-copy -->
    <p
      class="text-white/65 text-base md:text-lg mb-10 max-w-xl mx-auto leading-relaxed"
      style="font-family: var(--font-sans, Inter, system-ui);"
    >
      30 minutes. No commitment. We answer everything — legal, financial, and practical — in plain English.
    </p>

    <!-- CTA row -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="https://wa.me/50684291847?text=Hello!%20I'd%20like%20to%20schedule%20a%20free%20consultation%20about%20buying%20land%20in%20La%20Fortuna."
        target="_blank"
        rel="noopener noreferrer"
        data-wa-location="mid-page-cta"
        class="group inline-flex items-center gap-3 bg-[#C9A24E] hover:bg-[#B8912E] text-[#0d2218] font-semibold text-base px-8 py-4 rounded-none tracking-wide shadow-[0_8px_24px_rgba(201,162,78,0.4)] hover:shadow-[0_12px_40px_rgba(201,162,78,0.6)] transition-all duration-300 hover:-translate-y-0.5"
      >
        <WhatsappIcon className="w-5 h-5" />
        Book Free Consultation
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a
        href="/properties"
        class="inline-flex items-center gap-2 text-white/70 hover:text-white font-medium text-sm tracking-wide border-b border-white/25 hover:border-white/70 pb-0.5 transition-all duration-200"
        style="font-family: var(--font-sans);"
      >
        Browse Properties First
      </a>
    </div>

    <!-- Trust micro-copy -->
    <p class="mt-6 text-white/35 text-xs tracking-wide" style="font-family: var(--font-sans);">
      No pressure · Response within a few hours · Free, always
    </p>
  </div>
</section>

<style>
  .cta-section {
    min-height: 480px;
  }
</style>

<script>
  const section = document.querySelector('.cta-section') as HTMLElement | null;
  const bg = document.querySelector('.cta-bg') as HTMLElement | null;

  if (bg && section) {
    window.addEventListener('scroll', () => {
      const rect = section.getBoundingClientRect();
      const progress = 1 - rect.bottom / (window.innerHeight + rect.height);
      const y = (progress - 0.5) * 50;
      bg.style.transform = `scale(1.15) translateY(${y}px)`;
    }, { passive: true });
  }
</script>
