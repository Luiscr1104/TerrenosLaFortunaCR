---
// src/components/sections/FeaturedBlogs.astro
import { getCollection } from "astro:content";

interface Post {
  title: string
  slug: string
  excerpt: string
  image: string
  date: string // ISO or human string
  category?: string
  readingTime?: string
}

interface Props {
  heading?: string
  subheading?: string
  posts?: Post[]
  moreHref?: string
  accent?: string
  dark?: string
}

const {
  heading = "Featured Articles",
  subheading = "Insightful market updates, buying guidance, and lifestyle perspectives from La Fortuna and Costa Rica.",
  posts: propPosts,
  moreHref = "/blog",
  accent = "#16a34a",
  dark = "#052e14",
} = Astro.props;

let posts = propPosts;
if (!posts) {
  const allPosts = await getCollection("blog");
  const sortedPosts = allPosts.sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
  );

  posts = sortedPosts.slice(0, 3).map((post) => ({
    title: post.data.title,
    slug: `/blog/${post.slug}`,
    excerpt: post.data.excerpt,
    image: post.data.image,
    date: post.data.date.toISOString(),
    category: post.data.category,
    readingTime: post.data.readingTime,
  }));
}
---

<section
  id="featured-blogs"
  class="relative py-20 bg-[#0d2218] overflow-hidden"
>
  <!-- Ambient background orb -->
  <div class="absolute -top-1/3 -right-1/4 w-[50vw] h-[50vw] rounded-full bg-[#1a4a2e]/40 blur-[100px] pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(201,162,78,0.03),transparent_55%)] pointer-events-none"></div>

  <!-- Header -->
  <div class="relative text-center mb-12 md:mb-16 px-4">
    <div class="flex items-center justify-center gap-3 mb-6">
      <div class="h-px w-10 bg-[#C9A24E]/50"></div>
      <span
        class="text-[#C9A24E] text-xs font-medium tracking-[0.35em] uppercase"
        style="font-family: var(--font-sans, Inter, system-ui);"
      >Read · Learn · Invest</span>
      <div class="h-px w-10 bg-[#C9A24E]/50"></div>
    </div>

    <h2
      class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-4 tracking-tight leading-tight"
      style="font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);"
    >
      {heading}
      <span class="block italic text-[#C9A24E]">From La Fortuna</span>
    </h2>
    <p class="text-white/50 text-base md:text-lg max-w-3xl mx-auto leading-relaxed" style="font-family: var(--font-sans, Inter, system-ui);">
      {subheading}
    </p>
  </div>

  <!-- Grid -->
  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <article
          class="group relative rounded-2xl border border-white/8 bg-white/[0.04] hover:bg-white/[0.08] hover:border-[#C9A24E]/25 transition-all duration-500 overflow-hidden"
        >
          <!-- Media -->
          <div class="relative aspect-[16/10] overflow-hidden">
            <img
              src={post.image}
              alt={post.title}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.05]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0d2218]/60 via-black/10 to-transparent"></div>

            {post.category && (
              <div class="absolute top-3 left-3 rounded-full bg-[#C9A24E] text-[#0d2218] text-xs font-bold px-3 py-1">
                {post.category}
              </div>
            )}
          </div>

          <!-- Content -->
          <div class="p-6">
            <div class="flex items-center gap-3 text-xs text-white/35 mb-3" style="font-family: var(--font-sans, Inter, system-ui);">
              <time datetime={post.date}>
                {new Date(post.date).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "2-digit",
                })}
              </time>
              {post.readingTime && (
                <>
                  <span class="opacity-40">•</span>
                  <span>{post.readingTime}</span>
                </>
              )}
            </div>

            <h3
              class="text-lg md:text-xl font-bold text-white leading-snug mb-3 group-hover:text-[#C9A24E] transition-colors duration-200"
              style="font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);"
            >
              <a href={post.slug} class="focus:outline-none focus:ring-2 focus:ring-[#C9A24E]/50 rounded">
                {post.title}
              </a>
            </h3>

            <p class="text-white/50 text-sm leading-relaxed line-clamp-3 mb-4" style="font-family: var(--font-sans, Inter, system-ui);">
              {post.excerpt}
            </p>

            <a
              href={post.slug}
              class="inline-flex items-center gap-2 text-[#C9A24E] text-sm font-medium hover:text-[#E2C988] transition-colors"
              style="font-family: var(--font-sans);"
              aria-label={`Read: ${post.title}`}
            >
              Read article
              <svg class="h-4 w-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.172 12l-4.95-4.95 1.414-1.414L16 12l-6.364 6.364-1.414-1.414z" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- View more -->
    <div class="text-center mt-12">
      <a
        href={moreHref}
        class="inline-flex items-center gap-2 bg-[#C9A24E] hover:bg-[#B8912E] text-[#0d2218] px-8 py-4 font-semibold text-sm tracking-wide shadow-[0_8px_24px_rgba(201,162,78,0.35)] hover:shadow-[0_12px_32px_rgba(201,162,78,0.55)] transition-all duration-300 hover:-translate-y-0.5"
        style="font-family: var(--font-sans, Inter, system-ui);"
      >
        View more articles
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M13.172 12l-4.95-4.95 1.414-1.414L16 12l-6.364 6.364-1.414-1.414z" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Soft gold glow -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.06] bg-[radial-gradient(60%_40%_at_80%_0%,var(--accent),transparent)]"></div>
</section>
