---
import ChapterMarker from "./editorial/ChapterMarker.astro";
import PullQuote from "./editorial/PullQuote.astro";

const guarantees = [
  {
    title: "100% Legal & Title-Clean",
    description:
      "Every property listed is verified with a Costa Rican notary. Clean Fee Simple title, no liens, no surprises.",
    icon: "shield-check",
  },
  {
    title: "Close From Anywhere",
    description:
      "Full remote-closing process: digital documents, international wire, bilingual notary. No flights required.",
    icon: "computer",
  },
  {
    title: "Live Video Tours",
    description:
      "Before you commit to anything, José walks the property with you on a live video call. See every corner, ask anything.",
    icon: "video",
  },
  {
    title: "Independent Escrow",
    description:
      "Your funds are held by a licensed Costa Rican escrow company — not us. Released only when title transfers to your name.",
    icon: "lock",
  },
  {
    title: "You Deal With the Owners",
    description:
      "No junior agents, no brokers. Luis and José handle your purchase personally from first message to deed signing.",
    icon: "users",
  },
  {
    title: "Full Due Diligence Package",
    description:
      "Registry report, survey, zoning, utilities — we prepare the complete due diligence file before you sign anything.",
    icon: "document",
  },
];

const countries = [
  { flag: "🇺🇸", name: "United States" },
  { flag: "🇨🇦", name: "Canada" },
  { flag: "🇩🇪", name: "Germany" },
  { flag: "🇨🇭", name: "Switzerland" },
  { flag: "🇬🇧", name: "United Kingdom" },
  { flag: "🇳🇱", name: "Netherlands" },
];

const iconPaths: Record<string, string> = {
  "shield-check":
    "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z",
  computer:
    "M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0H3",
  video:
    "M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z",
  lock: "M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z",
  users:
    "M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z",
  document:
    "M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z",
};
---

<section class="relative py-24 md:py-32 bg-[#0d2218] overflow-hidden">
  <!-- Nature photo texture — very low opacity, right-edge peek -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <img
      src="/797.webp"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover opacity-[0.06] select-none"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Animated background orbs -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="trust-orb-1 absolute -top-1/3 -right-1/4 w-[55vw] h-[55vw] rounded-full bg-[#1a4a2e]/50 blur-[100px]"></div>
    <div class="trust-orb-2 absolute -bottom-1/3 -left-1/4 w-[45vw] h-[45vw] rounded-full bg-[#C9A24E]/6 blur-[120px]"></div>
    <div class="trust-orb-3 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[30vw] h-[30vw] rounded-full bg-[#1a4a2e]/20 blur-[80px]"></div>
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(201,162,78,0.04),transparent_55%)] pointer-events-none"
  ></div>

  <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    <!-- Chapter marker -->
    <div class="mb-2">
      <ChapterMarker numeral="Ⅲ" label="The Promise" theme="dark" />
    </div>

    <!-- Header -->
    <div class="text-center mb-14 reveal">
      <h2
        class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-4 tracking-tight leading-tight"
        style="font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);"
      >
        The Land Is Real.
        <span class="block italic text-[#C9A24E]">So Is the Protection.</span>
      </h2>
      <p class="text-white/55 text-lg max-w-2xl mx-auto" style="font-family: var(--font-sans, Inter, system-ui);">
        The jungle doesn't come with fine print — but land purchases do.
        Every step of our process is designed to protect you legally, financially, and personally.
      </p>
    </div>

    <!-- Guarantees Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
      {
        guarantees.map((item, i) => (
          <div class={`group flex gap-4 bg-white/[0.04] hover:bg-white/[0.08] border border-white/8 hover:border-[#C9A24E]/25 rounded-2xl p-6 transition-all duration-400 reveal reveal-delay-${(i % 3) + 1}`}>
            <!-- Icon circle -->
            <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-[#C9A24E]/10 border border-[#C9A24E]/15 flex items-center justify-center group-hover:bg-[#C9A24E]/20 transition-colors duration-300 mt-0.5">
              <svg
                class="w-5 h-5 text-[#C9A24E]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="1.75"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={iconPaths[item.icon]}
                />
              </svg>
            </div>
            <!-- Content -->
            <div>
              <h3
                class="text-white font-semibold text-sm mb-1.5 group-hover:text-[#C9A24E] transition-colors duration-200"
                style="font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif); font-size: 1rem; font-weight: 600;"
              >
                {item.title}
              </h3>
              <p class="text-white/50 text-sm leading-relaxed" style="font-family: var(--font-sans, Inter, system-ui);">
                {item.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Countries bar -->
    <div
      class="bg-white/[0.03] border border-white/8 rounded-2xl px-6 py-4 flex flex-wrap items-center justify-center gap-x-8 gap-y-3"
    >
      <span
        class="text-white/30 text-xs font-medium uppercase tracking-[0.15em] w-full text-center sm:w-auto"
        style="font-family: var(--font-sans);"
        >Serving buyers from</span
      >
      {
        countries.map((c) => (
          <span class="text-white/65 text-sm font-medium hover:text-white/90 transition-colors cursor-default" style="font-family: var(--font-sans);">
            {c.flag} {c.name}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes orb-drift-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(3%, -4%) scale(1.06); }
    66% { transform: translate(-2%, 3%) scale(0.96); }
  }

  @keyframes orb-drift-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-4%, 3%) scale(0.95); }
    66% { transform: translate(3%, -2%) scale(1.04); }
  }

  @keyframes orb-drift-3 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50% { transform: translate(-50%, -50%) scale(1.15); }
  }

  .trust-orb-1 { animation: orb-drift-1 14s ease-in-out infinite; }
  .trust-orb-2 { animation: orb-drift-2 18s ease-in-out infinite; animation-delay: 2s; }
  .trust-orb-3 { animation: orb-drift-3 10s ease-in-out infinite; animation-delay: 1s; }

  @media (prefers-reduced-motion: reduce) {
    .trust-orb-1, .trust-orb-2, .trust-orb-3 { animation: none; }
  }
</style>
