---
interface Props {
  variant?: "light" | "dark";
}
const { variant = "light" } = Astro.props;
const op = variant === "dark" ? "0.75" : "0.65";
---

<div class="mfield" aria-hidden="true">

  <!-- Shared gradient definitions -->
  <svg width="0" height="0" style="position:absolute;overflow:hidden;pointer-events:none">
    <defs>
      <radialGradient id="mgFWL" cx="32%" cy="30%" r="72%">
        <stop offset="0%"   stop-color="#90CAF9"/>
        <stop offset="18%"  stop-color="#2196F3"/>
        <stop offset="48%"  stop-color="#1565C0"/>
        <stop offset="80%"  stop-color="#0D47A1"/>
        <stop offset="100%" stop-color="#061236"/>
      </radialGradient>
      <radialGradient id="mgFWR" cx="68%" cy="30%" r="72%">
        <stop offset="0%"   stop-color="#90CAF9"/>
        <stop offset="18%"  stop-color="#2196F3"/>
        <stop offset="48%"  stop-color="#1565C0"/>
        <stop offset="80%"  stop-color="#0D47A1"/>
        <stop offset="100%" stop-color="#061236"/>
      </radialGradient>
      <radialGradient id="mgHWL" cx="30%" cy="68%" r="74%">
        <stop offset="0%"   stop-color="#64B5F6"/>
        <stop offset="25%"  stop-color="#1976D2"/>
        <stop offset="58%"  stop-color="#1565C0"/>
        <stop offset="100%" stop-color="#071640"/>
      </radialGradient>
      <radialGradient id="mgHWR" cx="70%" cy="68%" r="74%">
        <stop offset="0%"   stop-color="#64B5F6"/>
        <stop offset="25%"  stop-color="#1976D2"/>
        <stop offset="58%"  stop-color="#1565C0"/>
        <stop offset="100%" stop-color="#071640"/>
      </radialGradient>
    </defs>
  </svg>

  <!-- Butterfly 1 — large, upper left -->
  <div class="morpho m1">
    <svg class="msvg" viewBox="0 0 200 148" xmlns="http://www.w3.org/2000/svg" style={`opacity:${op}`}>
      <g class="wL" style="--fd:0.60s;--fdl:0s">
        <path d="M94,65 C85,51 55,21 13,7 Q1,23 5,49 C9,63 31,75 61,77 C75,78 92,70 94,67 Z"
              fill="url(#mgFWL)" stroke="#030314" stroke-width="9" stroke-linejoin="round" paint-order="stroke fill"/>
        <path d="M94,65 C87,53 64,28 32,14 Q18,24 20,40 C34,38 60,44 84,62 Z" fill="white" opacity="0.13"/>
        <line x1="93" y1="66" x2="22" y2="20" stroke="#0a2e70" stroke-width="0.6" opacity="0.5"/>
        <line x1="93" y1="66" x2="10" y2="42" stroke="#0a2e70" stroke-width="0.6" opacity="0.4"/>
        <circle cx="6"  cy="29" r="2.4" fill="white" opacity="0.92"/>
        <circle cx="5"  cy="43" r="2.2" fill="white" opacity="0.82"/>
        <circle cx="9"  cy="57" r="1.9" fill="white" opacity="0.70"/>
        <path d="M90,75 C78,86 48,98 22,107 Q6,117 12,129 Q28,139 50,127 C64,119 78,101 88,84 Z"
              fill="url(#mgHWL)" stroke="#030314" stroke-width="8" stroke-linejoin="round" paint-order="stroke fill"/>
        <path d="M90,75 C80,84 56,95 34,103 Q20,112 20,120 C34,114 54,110 74,98 Z" fill="white" opacity="0.10"/>
        <circle cx="10" cy="122" r="2.2" fill="white" opacity="0.85"/>
        <circle cx="24" cy="132" r="2.0" fill="white" opacity="0.72"/>
        <circle cx="40" cy="132" r="1.8" fill="white" opacity="0.60"/>
      </g>
      <g class="wR" style="--fd:0.60s;--fdl:0s">
        <path d="M106,65 C115,51 145,21 187,7 Q199,23 195,49 C191,63 169,75 139,77 C125,78 108,70 106,67 Z"
              fill="url(#mgFWR)" stroke="#030314" stroke-width="9" stroke-linejoin="round" paint-order="stroke fill"/>
        <path d="M106,65 C113,53 136,28 168,14 Q182,24 180,40 C166,38 140,44 116,62 Z" fill="white" opacity="0.13"/>
        <line x1="107" y1="66" x2="178" y2="20" stroke="#0a2e70" stroke-width="0.6" opacity="0.5"/>
        <line x1="107" y1="66" x2="190" y2="42" stroke="#0a2e70" stroke-width="0.6" opacity="0.4"/>
        <circle cx="194" cy="29" r="2.4" fill="white" opacity="0.92"/>
        <circle cx="195" cy="43" r="2.2" fill="white" opacity="0.82"/>
        <circle cx="191" cy="57" r="1.9" fill="white" opacity="0.70"/>
        <path d="M110,75 C122,86 152,98 178,107 Q194,117 188,129 Q172,139 150,127 C136,119 122,101 112,84 Z"
              fill="url(#mgHWR)" stroke="#030314" stroke-width="8" stroke-linejoin="round" paint-order="stroke fill"/>
        <path d="M110,75 C120,84 144,95 166,103 Q180,112 180,120 C166,114 146,110 126,98 Z" fill="white" opacity="0.10"/>
        <circle cx="190" cy="122" r="2.2" fill="white" opacity="0.85"/>
        <circle cx="176" cy="132" r="2.0" fill="white" opacity="0.72"/>
        <circle cx="160" cy="132" r="1.8" fill="white" opacity="0.60"/>
      </g>
      <!-- Body -->
      <ellipse cx="100" cy="69" rx="5" ry="8" fill="#030314"/>
      <rect x="96.5" y="76" width="7" height="28" rx="3.5" fill="#030314"/>
      <line x1="97" y1="83" x2="103" y2="83" stroke="#1c1c3e" stroke-width="0.9"/>
      <line x1="97" y1="90" x2="103" y2="90" stroke="#1c1c3e" stroke-width="0.9"/>
      <line x1="97" y1="97" x2="103" y2="97" stroke="#1c1c3e" stroke-width="0.9"/>
      <circle cx="100" cy="60" r="5.5" fill="#030314"/>
      <ellipse cx="96"  cy="58.5" rx="1.6" ry="1.4" fill="#24185a"/>
      <ellipse cx="104" cy="58.5" rx="1.6" ry="1.4" fill="#24185a"/>
      <path d="M97,56 Q80,37 72,19" stroke="#030314" stroke-width="1.4" fill="none" stroke-linecap="round"/>
      <circle cx="72" cy="19" r="3.4" fill="#030314"/>
      <path d="M103,56 Q120,37 128,19" stroke="#030314" stroke-width="1.4" fill="none" stroke-linecap="round"/>
      <circle cx="128" cy="19" r="3.4" fill="#030314"/>
    </svg>
  </div>

  <!-- Butterfly 2 — medium, right side -->
  <div class="morpho m2">
    <svg class="msvg" viewBox="0 0 200 148" xmlns="http://www.w3.org/2000/svg" style={`opacity:${op}`}>
      <g class="wL" style="--fd:0.54s;--fdl:-0.12s">
        <path d="M94,65 C85,51 55,21 13,7 Q1,23 5,49 C9,63 31,75 61,77 C75,78 92,70 94,67 Z"
              fill="url(#mgFWL)" stroke="#030314" stroke-width="9" stroke-linejoin="round" paint-order="stroke fill"/>
        <path d="M94,65 C87,53 64,28 32,14 Q18,24 20,40 C34,38 60,44 84,62 Z" fill="white" opacity="0.13"/>
        <line x1="93" y1="66" x2="22" y2="20" stroke="#0a2e70" stroke-width="0.6" opacity="0.5"/>
        <circle cx="6"  cy="29" r="2.4" fill="white" opacity="0.92"/>
        <circle cx="5"  cy="43" r="2.2" fill="white" opacity="0.80"/>
        <circle cx="9"  cy="57" r="1.9" fill="white" opacity="0.68"/>
        <path d="M90,75 C78,86 48,98 22,107 Q6,117 12,129 Q28,139 50,127 C64,119 78,101 88,84 Z"
              fill="url(#mgHWL)" stroke="#030314" stroke-width="8" stroke-linejoin="round" paint-order="stroke fill"/>
        <circle cx="10" cy="122" r="2.2" fill="white" opacity="0.82"/>
        <circle cx="24" cy="132" r="2.0" fill="white" opacity="0.68"/>
      </g>
      <g class="wR" style="--fd:0.54s;--fdl:-0.12s">
        <path d="M106,65 C115,51 145,21 187,7 Q199,23 195,49 C191,63 169,75 139,77 C125,78 108,70 106,67 Z"
              fill="url(#mgFWR)" stroke="#030314" stroke-width="9" stroke-linejoin="round" paint-order="stroke fill"/>
        <path d="M106,65 C113,53 136,28 168,14 Q182,24 180,40 C166,38 140,44 116,62 Z" fill="white" opacity="0.13"/>
        <line x1="107" y1="66" x2="178" y2="20" stroke="#0a2e70" stroke-width="0.6" opacity="0.5"/>
        <circle cx="194" cy="29" r="2.4" fill="white" opacity="0.92"/>
        <circle cx="195" cy="43" r="2.2" fill="white" opacity="0.80"/>
        <circle cx="191" cy="57" r="1.9" fill="white" opacity="0.68"/>
        <path d="M110,75 C122,86 152,98 178,107 Q194,117 188,129 Q172,139 150,127 C136,119 122,101 112,84 Z"
              fill="url(#mgHWR)" stroke="#030314" stroke-width="8" stroke-linejoin="round" paint-order="stroke fill"/>
        <circle cx="190" cy="122" r="2.2" fill="white" opacity="0.82"/>
        <circle cx="176" cy="132" r="2.0" fill="white" opacity="0.68"/>
      </g>
      <!-- Body -->
      <ellipse cx="100" cy="69" rx="5" ry="8" fill="#030314"/>
      <rect x="96.5" y="76" width="7" height="28" rx="3.5" fill="#030314"/>
      <line x1="97" y1="83" x2="103" y2="83" stroke="#1c1c3e" stroke-width="0.9"/>
      <line x1="97" y1="90" x2="103" y2="90" stroke="#1c1c3e" stroke-width="0.9"/>
      <circle cx="100" cy="60" r="5.5" fill="#030314"/>
      <ellipse cx="96"  cy="58.5" rx="1.6" ry="1.4" fill="#24185a"/>
      <ellipse cx="104" cy="58.5" rx="1.6" ry="1.4" fill="#24185a"/>
      <path d="M97,56 Q80,37 72,19" stroke="#030314" stroke-width="1.4" fill="none" stroke-linecap="round"/>
      <circle cx="72" cy="19" r="3.4" fill="#030314"/>
      <path d="M103,56 Q120,37 128,19" stroke="#030314" stroke-width="1.4" fill="none" stroke-linecap="round"/>
      <circle cx="128" cy="19" r="3.4" fill="#030314"/>
    </svg>
  </div>

</div>

<style>
  .mfield {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 2;
  }

  .morpho { position: absolute; }

  .msvg {
    display: block;
    filter: drop-shadow(0 0 6px rgba(100, 181, 246, 0.45))
            drop-shadow(0 0 2px rgba(33, 150, 243, 0.28));
  }

  .wL {
    transform-origin: right center;
    animation: flapL var(--fd, 0.60s) cubic-bezier(0.45, 0, 0.55, 1) infinite var(--fdl, 0s);
  }
  .wR {
    transform-origin: left center;
    animation: flapR var(--fd, 0.60s) cubic-bezier(0.45, 0, 0.55, 1) infinite var(--fdl, 0s);
  }

  @keyframes flapL {
    0%, 100% { transform: scaleX(1)    scaleY(1);    }
    44%       { transform: scaleX(0.05) scaleY(0.94); }
  }
  @keyframes flapR {
    0%, 100% { transform: scaleX(1)    scaleY(1);    }
    44%       { transform: scaleX(0.05) scaleY(0.94); }
  }

  @keyframes drift1 {
    0%   { transform: translate(0px,   0px)  rotate(-7deg);  }
    25%  { transform: translate(34px, -44px) rotate(11deg);  }
    52%  { transform: translate(54px, -26px) rotate(-3deg);  }
    76%  { transform: translate(20px, -58px) rotate(14deg);  }
    100% { transform: translate(0px,   0px)  rotate(-7deg);  }
  }
  @keyframes drift2 {
    0%   { transform: translate(0px,   0px)  rotate(6deg);   }
    30%  { transform: translate(-30px,-38px) rotate(-11deg); }
    58%  { transform: translate(-48px,-20px) rotate(4deg);   }
    80%  { transform: translate(-16px,-50px) rotate(-8deg);  }
    100% { transform: translate(0px,   0px)  rotate(6deg);   }
  }

  .m1 { top: 12%;  left: 6%;   width: 76px; animation: drift1 14s ease-in-out infinite; }
  .m2 { top: 55%;  right: 10%; width: 54px; animation: drift2 17s ease-in-out infinite -5s; }

  @media (prefers-reduced-motion: reduce) {
    .morpho, .wL, .wR { animation: none !important; }
  }
</style>
