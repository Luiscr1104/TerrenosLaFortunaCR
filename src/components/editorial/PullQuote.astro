---
interface Props {
  quote: string;
  attribution?: string;
  theme?: "light" | "dark";
  size?: "sm" | "md" | "lg";
}

const { quote, attribution, theme = "light", size = "md" } = Astro.props;

const isLight = theme === "light";
const quoteColor = isLight ? "text-[#0d2218]" : "text-white";
const attrColor = isLight ? "text-[#1a4a2e]/60" : "text-white/50";
const accentColor = isLight ? "bg-[#C9A24E]" : "bg-[#C9A24E]";

const sizeClass = {
  sm: "text-xl md:text-2xl",
  md: "text-2xl md:text-3xl",
  lg: "text-3xl md:text-4xl lg:text-5xl",
}[size];
---

<blockquote class="relative pl-6 my-8">
  <div class={`absolute left-0 top-2 bottom-2 w-0.5 ${accentColor} rounded-full`}></div>
  <p
    class={`font-display italic leading-snug ${quoteColor} ${sizeClass}`}
    style="font-family: var(--font-display);"
  >
    {quote}
  </p>
  {attribution && (
    <footer class={`mt-3 text-sm font-medium tracking-wide ${attrColor}`}>
      — {attribution}
    </footer>
  )}
</blockquote>
