---
// Subtle SVG noise overlay applied once at layout level.
// pointer-events-none ensures it never blocks interactions.
---

<div
  class="fixed inset-0 z-[9999] pointer-events-none select-none"
  aria-hidden="true"
>
  <svg
    class="w-full h-full opacity-[0.035]"
    xmlns="http://www.w3.org/2000/svg"
    style="mix-blend-mode: multiply;"
  >
    <filter id="grain">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.65"
        numOctaves="3"
        stitchTiles="stitch"
      />
      <feColorMatrix type="saturate" values="0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#grain)" />
  </svg>
</div>
