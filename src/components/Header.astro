---
// src/components/layout/Header.astro
import Logo from "./Logo.astro";
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 bg-neutral-900/90 backdrop-blur-md shadow-xl transition-all duration-300 border-b border-white/10"
>
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    <div class="flex items-center justify-between h-20 lg:h-24">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group text-white">
        <Logo class="h-14 w-auto sm:hidden" type="icon" />
        <Logo class="hidden sm:block h-16 w-auto" type="full" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-8">
        <a
          href="/properties"
          class="text-white/90 hover:text-white font-medium transition-colors relative group"
        >
          Properties
          <span
            class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent-gold group-hover:w-full transition-all duration-300"
          ></span>
        </a>
        <a
          href="#why-buy"
          class="text-white/90 hover:text-white font-medium transition-colors relative group"
        >
          Why Buy Remote
          <span
            class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent-gold group-hover:w-full transition-all duration-300"
          ></span>
        </a>
        <a
          href="#about"
          class="text-white/90 hover:text-white font-medium transition-colors relative group"
        >
          About La Fortuna
          <span
            class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent-gold group-hover:w-full transition-all duration-300"
          ></span>
        </a>
      </div>

      <!-- CTA Buttons Desktop -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href="tel:+50689354697"
          class="inline-flex items-center gap-2 text-white/90 hover:text-white font-medium transition-colors"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          <span class="hidden xl:inline">+506 8935 4697</span>
        </a>
        <a
          href="https://wa.me/50689354697?text=Hello!%20I'm%20interested%20in%20one%20of%20your%20properties%20in%20La%20Fortuna.%20Could%20you%20please%20send%20me%20more%20details%20or%20available%20options?"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-accent-gold hover:bg-accent-gold/90 text-white px-5 py-2.5 rounded-lg font-semibold shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5"
        >
          Contact via WhatsApp
        </a>
      </div>
      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg text-white hover:bg-white/10 transition-colors"
        aria-label="Toggle menu"
      >
        <svg
          id="menu-open-icon"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="menu-close-icon"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile Menu -->
<div id="mobile-menu" class="lg:hidden hidden">
  <div
    class="px-4 pt-2 pb-6 space-y-3 bg-neutral-900/95 backdrop-blur-lg border-t border-white/10"
  >
    <a
      href="/properties"
      class="block px-4 py-3 text-white hover:bg-white/10 rounded-lg transition-colors font-medium"
    >
      Properties
    </a>
    <a
      href="#why-buy"
      class="block px-4 py-3 text-white hover:bg-white/10 rounded-lg transition-colors font-medium"
    >
      Why Buy Remote
    </a>
    <a
      href="#about"
      class="block px-4 py-3 text-white hover:bg-white/10 rounded-lg transition-colors font-medium"
    >
      About La Fortuna
    </a>

    <div class="pt-4 space-y-3">
      <a
        href="tel:+50689354697"
        class="flex items-center justify-center gap-2 w-full px-4 py-3 bg-white/10 text-white rounded-lg font-medium hover:bg-white/20 transition-colors"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          ></path>
        </svg>
        Call Us
      </a>
      <a
        href="https://wa.me/89354697?text=Hello,%20I'm%20interested%20in%20La%20Fortuna%20properties"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full px-4 py-3 bg-accent-gold hover:bg-accent-gold/90 text-white rounded-lg font-semibold transition-colors"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.96 9.96 0 0 0 1.332 4.993L2 22l5.083-1.334a9.96 9.96 0 0 0 4.928 1.317h.004a9.99 9.99 0 0 0 9.99-9.982C22.002 6.666 17.522 2 12.012 2zm0 18.288h-.004a8.27 8.27 0 0 1-4.22-1.157l-.302-.18-3.138.823.838-3.058-.196-.313a8.28 8.28 0 0 1-1.27-4.417c.002-4.57 3.725-8.287 8.29-8.287 2.214 0 4.295.863 5.86 2.428a8.26 8.26 0 0 1 2.433 5.865c-.003 4.568-3.725 8.286-8.29 8.296zm4.538-6.205c-.248-.124-1.472-.726-1.7-.81-.226-.082-.392-.123-.556.124-.166.248-.642.81-.787.974-.144.166-.29.186-.537.062-.248-.125-1.047-.386-1.994-1.23-1.74-1.55-2.07-2.48-2.31-2.88-.23-.39-.18-.56.05-.78.21-.19.46-.49.69-.74.23-.25.3-.42.45-.7.15-.27.07-.52-.04-.73-.11-.2-.56-2.28-.99-2.67-.3-.26-.64-.23-.87-.23-.23 0-.5.08-.76.36-.26.29-1 .98-1 2.38s1.02 2.76 1.16 2.95c.14.19 2 3.06 4.85 4.29 2.84 1.23 2.84.82 3.36.76.51-.06 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.16-.48-.28z"
          ></path>
        </svg>
        WhatsApp Us
      </a>
    </div>
  </div>
</div>

<script is:inline>
  // Mobile menu toggle
  function setupMobileMenu() {
    const menuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    const openIcon = document.getElementById("menu-open-icon");
    const closeIcon = document.getElementById("menu-close-icon");

    if (!menuButton || !mobileMenu || !openIcon || !closeIcon) return;

    menuButton.addEventListener("click", () => {
      const isHidden = mobileMenu.classList.contains("hidden");

      if (isHidden) {
        mobileMenu.classList.remove("hidden");
        openIcon.classList.add("hidden");
        closeIcon.classList.remove("hidden");
      } else {
        mobileMenu.classList.add("hidden");
        openIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      }
    });

    // Close menu when clicking a link
    const menuLinks = mobileMenu.querySelectorAll("a");
    menuLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        openIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      });
    });
  }

  // Initialize on load
  setupMobileMenu();
</script>

<style>
  /* Header is always solid dark */
</style>
