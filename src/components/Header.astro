---
import Logo from "./Logo.astro";
import WhatsappIcon from "./WhatsappIcon.astro";

const navLinks = [
  { label: "Properties",   href: "/properties",   num: "01" },
  { label: "Why Remote",   href: "/#why-buy",      num: "02" },
  { label: "La Fortuna",   href: "/#about",        num: "03" },
  { label: "Contact",      href: "/#contact",      num: "04" },
];
---

<!-- ═══════════════════════════════════════════════════════ HEADER ══ -->
<header id="site-header" class="fixed top-0 left-0 right-0 z-50">
  <!-- Animated background layer -->
  <div
    id="hdr-bg"
    class="absolute inset-0 pointer-events-none"
    style="background: rgba(13,34,24,0.97); backdrop-filter: blur(18px) saturate(1.4); opacity:0; transition: opacity 0.45s ease;"
  ></div>

  <!-- Gold bottom rule -->
  <div
    id="hdr-rule"
    class="absolute bottom-0 left-0 right-0 h-px pointer-events-none"
    style="background: linear-gradient(90deg, transparent 0%, rgba(201,162,78,0.35) 35%, rgba(201,162,78,0.55) 50%, rgba(201,162,78,0.35) 65%, transparent 100%); transform: scaleX(0); transform-origin: center; transition: transform 0.65s cubic-bezier(0.16,1,0.3,1);"
  ></div>

  <nav class="relative container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16 lg:h-[4.5rem]">

      <!-- ── Logo ──────────────────────────────────────────────────── -->
      <a href="/" class="flex items-center text-white flex-shrink-0 group" aria-label="BuyLandCR — home">
        <Logo class="h-11 w-auto sm:hidden" type="icon" />
        <Logo class="hidden sm:block h-14 w-auto" type="full" />
      </a>

      <!-- ── Desktop links ─────────────────────────────────────────── -->
      <div class="hidden lg:flex items-center" role="list">
        {navLinks.map((link, i) => (
          <span role="listitem" class="flex items-center">
            {i > 0 && <span class="w-px h-3 bg-white/15 mx-0.5" aria-hidden="true"></span>}
            <a
              href={link.href}
              class="relative group px-5 py-6 cursor-pointer"
            >
              <span
                class="text-[10px] uppercase tracking-[0.26em] font-semibold text-white/65 group-hover:text-white transition-colors duration-200"
                style="font-family: var(--font-sans, Inter, system-ui);"
              >
                {link.label}
              </span>
              <!-- Gold underline on hover -->
              <span
                class="absolute bottom-4 left-5 right-5 h-px bg-[#C9A24E] origin-center scale-x-0 group-hover:scale-x-100 transition-transform duration-300"
              ></span>
            </a>
          </span>
        ))}
      </div>

      <!-- ── Desktop CTAs ──────────────────────────────────────────── -->
      <div class="hidden lg:flex items-center gap-4">
        <!-- Phone -->
        <a
          href="tel:+50684291847"
          class="flex items-center gap-1.5 text-white/45 hover:text-white/80 transition-colors duration-200 group"
          aria-label="Call us"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          <span
            class="text-[10px] tracking-[0.1em] hidden xl:inline"
            style="font-family: var(--font-sans, Inter, system-ui);"
          >+506 8429 1847</span>
        </a>

        <!-- WhatsApp CTA — sharp editorial, no border-radius -->
        <a
          href="https://wa.me/50684291847?text=Hello!%20I'm%20interested%20in%20one%20of%20your%20properties%20in%20La%20Fortuna.%20Could%20you%20please%20send%20me%20more%20details?"
          target="_blank"
          rel="noopener noreferrer"
          data-wa-location="header"
          class="inline-flex items-center gap-2 bg-[#C9A24E] text-[#0d2218] px-5 py-2.5 text-[10px] font-bold uppercase tracking-[0.18em] hover:brightness-105 active:brightness-95 transition-all duration-200 shadow-[0_4px_20px_rgba(201,162,78,0.25)] hover:shadow-[0_4px_28px_rgba(201,162,78,0.45)] hover:-translate-y-px"
          style="font-family: var(--font-sans, Inter, system-ui);"
        >
          <WhatsappIcon className="w-3.5 h-3.5 flex-shrink-0" />
          WhatsApp
        </a>
      </div>

      <!-- ── Mobile hamburger ──────────────────────────────────────── -->
      <button
        id="nav-toggle"
        class="lg:hidden flex flex-col items-end justify-center gap-[6px] w-10 h-10 cursor-pointer"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="nav-overlay"
      >
        <span class="ham-1 block w-6 h-[1.5px] bg-white origin-center transition-all duration-350"></span>
        <span class="ham-2 block w-4 h-[1.5px] bg-white/55 transition-all duration-350"></span>
        <span class="ham-3 block w-6 h-[1.5px] bg-white origin-center transition-all duration-350"></span>
      </button>

    </div>
  </nav>
</header>

<!-- ═══════════════════════════════════════════════ MOBILE OVERLAY ══ -->
<div
  id="nav-overlay"
  class="fixed inset-0 z-40 bg-[#0d2218] flex flex-col overflow-hidden"
  style="transform: translateX(100%); transition: transform 0.52s cubic-bezier(0.16, 1, 0.3, 1);"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <!-- Atmospheric blurs -->
  <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-[#C9A24E]/6 blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[500px] h-[400px] rounded-full bg-[#1a4a2e]/25 blur-3xl pointer-events-none"></div>

  <!-- Header-height spacer -->
  <div class="h-16 flex-shrink-0"></div>

  <!-- Thin gold divider -->
  <div class="mx-6 h-px bg-gradient-to-r from-transparent via-[#C9A24E]/30 to-transparent mb-10 flex-shrink-0"></div>

  <!-- ── Nav items ─────────────────────────────────────────────────── -->
  <nav class="flex-1 px-6 overflow-y-auto" aria-label="Mobile navigation">
    <ul class="space-y-0">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="mob-link flex items-baseline gap-5 py-5 border-b border-white/[0.08] group"
          >
            <span
              class="text-[#C9A24E]/40 text-[10px] uppercase tracking-[0.22em] font-semibold flex-shrink-0 w-5 group-hover:text-[#C9A24E]/70 transition-colors duration-200"
              style="font-family: var(--font-sans, Inter, system-ui);"
            >{link.num}</span>
            <span
              class="text-white text-4xl font-bold italic leading-none group-hover:text-[#C9A24E] transition-colors duration-200"
              style="font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);"
            >{link.label}</span>
            <!-- Arrow on hover -->
            <svg
              class="ml-auto w-5 h-5 text-[#C9A24E]/0 group-hover:text-[#C9A24E] transition-all duration-200 flex-shrink-0 -translate-x-2 group-hover:translate-x-0"
              fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- ── Mobile CTAs ───────────────────────────────────────────────── -->
  <div class="px-6 pb-10 pt-6 flex-shrink-0 space-y-3 border-t border-white/[0.08]">
    <a
      href="https://wa.me/50684291847?text=Hello!%20I'm%20interested%20in%20La%20Fortuna%20properties"
      target="_blank"
      rel="noopener noreferrer"
      data-wa-location="mobile-nav"
      class="flex items-center justify-center gap-2.5 w-full bg-[#C9A24E] text-[#0d2218] py-4 font-bold text-xs uppercase tracking-[0.16em] hover:brightness-105 transition-all"
      style="font-family: var(--font-sans, Inter, system-ui);"
    >
      <WhatsappIcon className="w-4 h-4" />
      WhatsApp Consultation
    </a>
    <a
      href="tel:+50684291847"
      class="flex items-center justify-center gap-2 w-full bg-white/[0.06] border border-white/10 text-white/60 py-3.5 text-xs font-medium tracking-[0.1em] hover:bg-white/[0.10] hover:text-white/80 transition-all"
      style="font-family: var(--font-sans, Inter, system-ui);"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
      </svg>
      +506 8429 1847
    </a>
    <p
      class="text-center text-white/20 text-[9px] tracking-[0.22em] uppercase pt-1"
      style="font-family: var(--font-sans, Inter, system-ui);"
    >La Fortuna · Arenal · Costa Rica</p>
  </div>
</div>

<!-- ════════════════════════════════════════════════════ SCRIPTS ══ -->
<script is:inline>
  (function () {
    var header   = document.getElementById('site-header');
    var hdrBg    = document.getElementById('hdr-bg');
    var hdrRule  = document.getElementById('hdr-rule');
    var overlay  = document.getElementById('nav-overlay');
    var toggle   = document.getElementById('nav-toggle');
    var ham1     = toggle.querySelector('.ham-1');
    var ham2     = toggle.querySelector('.ham-2');
    var ham3     = toggle.querySelector('.ham-3');
    var isOpen   = false;

    // ── Scroll: transparent → solid ──────────────────────────────
    function onScroll() {
      var scrolled = window.scrollY > 60;
      hdrBg.style.opacity   = scrolled ? '1' : '0';
      hdrRule.style.transform = scrolled ? 'scaleX(1)' : 'scaleX(0)';
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // run on load (non-hero pages are already scrolled or solid)

    // ── Mobile menu open/close ────────────────────────────────────
    function openMenu() {
      isOpen = true;
      overlay.style.transform = 'translateX(0)';
      overlay.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close navigation menu');
      document.body.style.overflow = 'hidden';
      // Animate hamburger → X
      ham1.style.transform = 'translateY(7.5px) rotate(45deg)';
      ham2.style.opacity   = '0';
      ham3.style.transform = 'translateY(-7.5px) rotate(-45deg)';
    }

    function closeMenu() {
      isOpen = false;
      overlay.style.transform = 'translateX(100%)';
      overlay.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation menu');
      document.body.style.overflow = '';
      // Reset hamburger
      ham1.style.transform = '';
      ham2.style.opacity   = '';
      ham3.style.transform = '';
    }

    toggle.addEventListener('click', function () {
      isOpen ? closeMenu() : openMenu();
    });

    // Close when link is clicked
    overlay.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closeMenu);
    });

    // Close on Escape key
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen) closeMenu();
    });
  })();
</script>
