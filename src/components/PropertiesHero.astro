---
// No props needed — pure text banner
---

<section class="mt-20 bg-[#0d2218] text-white pt-14 pb-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">

    <p
      class="text-[#C9A24E]/70 text-xs font-bold uppercase tracking-[0.22em] mb-4 animate-fade-up"
      style="animation-fill-mode: both; animation-delay: 0ms;"
    >
      La Fortuna · Arenal · Costa Rica
    </p>

    <h1
      class="font-bold leading-tight mb-4 animate-fade-up"
      style="font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 3.75rem); animation-fill-mode: both; animation-delay: 80ms; view-transition-name: title-properties;"
    >
      Land &amp; Luxury Homes<br />
      <span class="text-[#C9A24E]">for Sale in La Fortuna, Costa Rica</span>
    </h1>

    <p
      class="text-white/65 text-sm md:text-base max-w-xl mb-8 animate-fade-up"
      style="animation-fill-mode: both; animation-delay: 160ms;"
    >
      Volcano-view lots, eco retreats and luxury villas — full legal support for international buyers.
    </p>

    <!-- Quick-filter chips -->
    <div
      class="flex flex-wrap gap-2 animate-fade-up"
      style="animation-fill-mode: both; animation-delay: 240ms;"
    >
      <button
        class="hero-chip bg-white/10 hover:bg-[#C9A24E] hover:text-[#0d2218] text-white/80 border border-white/20 hover:border-[#C9A24E] px-4 py-2 rounded-full text-xs font-semibold transition-all duration-200"
        data-key="type" data-value="home"
      >
        🏠 Homes
      </button>
      <button
        class="hero-chip bg-white/10 hover:bg-[#C9A24E] hover:text-[#0d2218] text-white/80 border border-white/20 hover:border-[#C9A24E] px-4 py-2 rounded-full text-xs font-semibold transition-all duration-200"
        data-key="type" data-value="land"
      >
        🌳 Land
      </button>
      <button
        class="hero-chip bg-white/10 hover:bg-[#C9A24E] hover:text-[#0d2218] text-white/80 border border-white/20 hover:border-[#C9A24E] px-4 py-2 rounded-full text-xs font-semibold transition-all duration-200"
        data-key="price" data-value="under150"
      >
        Under $150k
      </button>
      <button
        class="hero-chip bg-white/10 hover:bg-[#C9A24E] hover:text-[#0d2218] text-white/80 border border-white/20 hover:border-[#C9A24E] px-4 py-2 rounded-full text-xs font-semibold transition-all duration-200"
        data-key="size" data-value="over3"
      >
        3+ acres
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.hero-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      const key   = btn.dataset.key   as string;
      const value = btn.dataset.value as string;

      // Update URL param
      const params = new URLSearchParams(window.location.search);
      params.set(key, value);
      window.history.replaceState({}, '', `?${params.toString()}`);

      // Notify React listing component
      window.dispatchEvent(new CustomEvent('hero-filter', { detail: { [key]: value } }));

      // Scroll to grid
      const target = document.getElementById('properties-listing');
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
