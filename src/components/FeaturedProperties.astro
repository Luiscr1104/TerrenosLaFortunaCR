---
import HeroTitle from "./HeroTitle";
import { getAllProperties } from "@/lib/properties";
import AnimatedStats from "./AnimatedStats";
import ChapterMarker from "./editorial/ChapterMarker.astro";

const allProperties = getAllProperties();
const homeCount = allProperties.filter((p) => p.type === "home").length;
const landCount = allProperties.filter((p) => p.type === "land").length;

const categories = [
  {
    type: "home",
    title: "Luxury Homes",
    subtitle: "Move-in-ready villas near Arenal Volcano",
    count: homeCount,
    href: "/homes",
    image: "https://imagedelivery.net/Lh5ivcu1Gl9SRBAdYRSP2g/5cd588c4-a4ad-4d7b-2265-c32b4e859900/public",
    imageAlt: "Luxury villa in La Fortuna, Costa Rica",
    eyebrow: "Homes & Villas",
  },
  {
    type: "land",
    title: "Premium Land",
    subtitle: "Titled hectares to build your dream from scratch",
    count: landCount,
    href: "/lands",
    image: "/sanrafael.webp",
    imageAlt: "Pristine land in the San Rafael valley, La Fortuna",
    eyebrow: "Lots & Parcels",
  },
];
---

<section
  id="properties"
  class="relative py-16 md:py-24 lg:py-32 bg-[#0d2218] overflow-hidden"
>
  <!-- Decorative radial glows -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-[#1a4a2e]/[0.07] rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-[#C9A24E]/[0.05] rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16 lg:mb-20 reveal">
      <ChapterMarker numeral="Ⅰ" label="The Properties" theme="dark" />
      <HeroTitle client:visible />

      <p class="text-lg md:text-xl text-white/55 max-w-3xl mx-auto mb-2" style="font-family: var(--font-sans, Inter, system-ui);">
        Wake up to Arenal Volcano. Fall asleep to howler monkeys. These are the
        parcels and homes where that life becomes real.
        <span class="font-semibold text-[#C9A24E]"
          >Every property personally inspected and title-verified.</span
        >
      </p>
    </div>

    <!-- Category Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-6xl mx-auto mb-16">
      {categories.map((cat, i) => (
        <a
          href={cat.href}
          class={`group relative block rounded-3xl overflow-hidden shadow-[0_24px_64px_rgba(0,0,0,0.35)] ring-1 ring-white/10 hover:ring-[#C9A24E]/40 transition-all duration-500 hover:-translate-y-1 hover:shadow-[0_32px_80px_rgba(0,0,0,0.45)] reveal reveal-delay-${i + 1}`}
          style="aspect-ratio: 4/5;"
        >
          <!-- Background photo -->
          <div class="absolute inset-0 overflow-hidden">
            <img
              src={cat.image}
              alt={cat.imageAlt}
              class="w-full h-full object-cover object-center transition-transform duration-[1000ms] ease-out group-hover:scale-110"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Dark gradient overlay — heavier at bottom for text legibility -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#0d2218]/95 via-[#0d2218]/45 to-[#0d2218]/10 pointer-events-none"></div>

          <!-- Top badge -->
          <div class="absolute top-6 left-6">
            <span
              class="inline-flex items-center gap-1.5 bg-[#C9A24E]/20 border border-[#C9A24E]/40 text-[#C9A24E] text-[10px] font-semibold tracking-[0.28em] uppercase px-3 py-1.5 rounded-full backdrop-blur-sm"
              style="font-family: var(--font-sans, Inter, system-ui);"
            >
              {cat.eyebrow}
            </span>
          </div>

          <!-- Bottom content -->
          <div class="absolute bottom-0 left-0 right-0 p-8">
            <!-- Property count -->
            <div class="flex items-center gap-2 mb-3">
              <div class="h-px w-5 bg-[#C9A24E]/70"></div>
              <span
                class="text-[#C9A24E]/80 text-[11px] font-semibold tracking-[0.22em] uppercase"
                style="font-family: var(--font-sans, Inter, system-ui);"
              >
                {cat.count} {cat.count === 1 ? "Property" : "Properties"} Available
              </span>
            </div>

            <!-- Title -->
            <h3
              class="text-4xl md:text-5xl font-bold italic text-white leading-tight mb-2 group-hover:text-[#C9A24E] transition-colors duration-300"
              style="font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif); text-shadow: 0 2px 20px rgba(0,0,0,0.6);"
            >
              {cat.title}
            </h3>

            <!-- Subtitle -->
            <p
              class="text-white/60 text-sm mb-6 leading-relaxed"
              style="font-family: var(--font-sans, Inter, system-ui);"
            >
              {cat.subtitle}
            </p>

            <!-- CTA row -->
            <div class="flex items-center gap-3 text-[#C9A24E]">
              <span
                class="text-sm font-semibold tracking-wide"
                style="font-family: var(--font-sans, Inter, system-ui);"
              >
                Explore Catalog
              </span>
              <svg
                class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"
                />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Stats Bar -->
    <AnimatedStats client:visible />
  </div>
</section>
