---
import ShowcaseCarousel, { type Offer } from "./ShowcaseCarousel";

interface Props {
  offers?: Offer[];
  // Legacy props for backward compatibility (optional)
  title?: string;
  subtitle?: string;
  promoTitle?: string;
  promoHighlight?: string;
  ctaLabel?: string;
  ctaHref?: string;
  image?: string;
  videoUrl?: string;
  locationChip?: string;
  stats?: { label: string; value: string }[];
  accent?: string;
}

const {
  offers,
  // Fallback to single offer props if 'offers' is not provided
  title,
  subtitle,
  promoTitle,
  promoHighlight,
  ctaLabel,
  ctaHref,
  image,
  videoUrl,
  locationChip,
  stats,
  accent,
} = Astro.props;

// Construct the offers array
const carouselOffers: Offer[] = offers || [
  {
    title: title || "Luxury 4BR Villa with Pool & Jacuzzi",
    subtitle:
      subtitle ||
      "3,000 m² lot • 4 beds, 3 baths • Social area with bar & pool table • 16 min from La Fortuna • Turn-key or Airbnb-ready. Target price: $715,000 (≈ CRC ₡375M).",
    promoTitle: promoTitle || "🔥 Hot Offer",
    promoHighlight: promoHighlight || "Arenal Volcano View",
    ctaLabel: ctaLabel || "See details",
    ctaHref: ctaHref || "/properties",
    image:
      image ||
      "https://imagedelivery.net/Lh5ivcu1Gl9SRBAdYRSP2g/44060157-e87e-4492-8987-3dc51ccac900/public",
    videoUrl: videoUrl || "",
    locationChip: locationChip || "La Fortuna (16 min), Costa Rica",
    stats: stats || [
      { value: "4 / 3", label: "Beds / Baths" },
      { value: "3,000 m²", label: "Lot Size" },
      { value: "$715k", label: "Target Price" },
    ],
    accent: accent || "#16a34a",
  },
];
---

<section class="relative py-12 md:py-20 bg-neutral-50/50">
  <ShowcaseCarousel client:visible offers={carouselOffers} />
</section>
