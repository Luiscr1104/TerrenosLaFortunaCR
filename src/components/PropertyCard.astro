---
// src/components/ui/PropertyCard.astro
// src/components/ui/PropertyCard.astro
import WhatsappIcon from "./WhatsappIcon.astro";

interface Props {
  id: string;
  title: string;
  slug: string;
  price: number;
  type: "home" | "land";
  bedrooms?: number;
  bathrooms?: number;
  size: number;
  sizeUnit: string;
  landSize?: number;
  landUnit?: string;
  location: string;
  featured?: boolean;
  images: string[];
  features: string[];
  description: string;
}

const {
  title,
  slug,
  price,
  type,
  bedrooms,
  bathrooms,
  size,
  sizeUnit,
  landSize,
  landUnit,
  location,
  featured = false,
  images,
  features,
} = Astro.props;

const formattedPrice = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
}).format(price);

const slugChip = `slug-${slug}`;
---

<article
  class="group relative bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 cursor-pointer"
>
  <a
    href={`/properties/${slug}`}
    aria-label={`View details: ${title}`}
    class="absolute inset-0 z-[5]"></a>

  <!-- Image Container -->
  <div class="relative aspect-[4/3] overflow-hidden bg-neutral-100">
    <img
      src={images[0]}
      alt={title}
      width="800"
      height="600"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
      style={`view-transition-name: prop-${slug};`}
    />

    <!-- Slug chip -->
    <span
      class="absolute bottom-3 left-3 rounded-full bg-black/55 text-white backdrop-blur px-2.5 py-1 text-[11px] font-mono tracking-tight z-10"
      style={`view-transition-name: ${slugChip};`}
    >
      {slug}
    </span>

    <!-- Badges overlay -->
    <div
      class="absolute top-3 left-3 right-3 flex items-start justify-between gap-2 z-10"
    >
      {
        featured && (
          <span class="bg-[#C9A24E] text-[#0d2218] px-2.5 py-1 rounded-full text-xs font-bold shadow-lg">
            ⭐ Featured
          </span>
        )
      }
      <span
        class="ml-auto bg-white/95 backdrop-blur-sm text-neutral-900 px-2.5 py-1 rounded-full text-xs font-semibold shadow-md"
      >
        {type === "home" ? "🏠 Home" : "🌳 Land"}
      </span>
    </div>

    <!-- Photo count -->
    {
      images.length > 1 && (
        <div class="absolute bottom-3 right-3 bg-black/70 backdrop-blur-sm text-white px-2.5 py-1 rounded-lg text-xs font-medium flex items-center gap-1.5 shadow-lg">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z"
              clip-rule="evenodd"
            />
          </svg>
          {images.length} Photos
        </div>
      )
    }
  </div>

  <!-- Content -->
  <div class="p-4">
    <!-- Location - Enhanced readability -->
    <div class="flex items-center gap-1.5 text-sm text-neutral-700 mb-3">
      <svg
        class="w-4 h-4 text-[#1a4a2e]"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
        ></path>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      <span class="font-semibold">{location}</span>
    </div>

    <!-- Title - Larger and bolder -->
    <h3
      class="text-lg font-bold text-[#0d2218] mb-3 line-clamp-2 leading-snug group-hover:text-[#1a4a2e] transition-colors min-h-[3rem]"
      style={`view-transition-name: title-${slug}; font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif); font-size: 1.15rem;`}
    >
      {title}
    </h3>

    <!-- Price - Larger and more prominent -->
    <div class="mb-4">
      <span class="text-3xl font-extrabold text-[#0d2218]"
        >{formattedPrice}</span
      >
    </div>

    <!-- Property specs - Enhanced readability -->
    <div
      class="flex flex-wrap items-center gap-4 text-sm text-neutral-800 mb-4 pb-4 border-b border-neutral-200"
    >
      {
        type === "home" && bedrooms && bathrooms && (
          <>
            <div class="flex items-center gap-1.5">
              <svg
                class="w-5 h-5 text-[#1a4a2e]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                />
              </svg>
              <span class="font-bold text-base">{bedrooms}</span>
              <span class="font-medium">Beds</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg
                class="w-5 h-5 text-[#1a4a2e]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"
                />
              </svg>
              <span class="font-bold text-base">{bathrooms}</span>
              <span class="font-medium">Baths</span>
            </div>
          </>
        )
      }
      <div class="flex items-center gap-1.5">
        <svg
          class="w-5 h-5 text-[#1a4a2e]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
          ></path>
        </svg>
        <span class="font-bold text-base">{size}</span>
        <span class="font-medium">{sizeUnit}</span>
      </div>
      {
        landSize && landUnit && (
          <div class="flex items-center gap-1.5">
            <svg
              class="w-5 h-5 text-[#1a4a2e]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <span class="font-bold text-base">{landSize}</span>
            <span class="font-medium">{landUnit} lot</span>
          </div>
        )
      }
    </div>

    <!-- Features - Enhanced readability -->
    <ul class="space-y-2 mb-4">
      {
        features.slice(0, 3).map((feature) => (
          <li class="flex items-start gap-2 text-sm text-neutral-800">
            <svg
              class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"
              />
            </svg>
            <span class="leading-snug font-medium">{feature}</span>
          </li>
        ))
      }
    </ul>

    {
      features.length > 3 && (
        <button class="text-sm text-[#1a4a2e] font-semibold mb-3 hover:text-[#0d2218] transition-colors">
          + {features.length - 3} more features
        </button>
      )
    }

    <!-- WhatsApp Button -->
    <a
      href={`https://wa.me/50689354697?text=Hi!%20I'm%20interested%20in:%20${encodeURIComponent(title)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white px-4 py-2.5 rounded-xl font-semibold text-sm transition-all duration-300 hover:shadow-lg active:scale-95 z-10 relative"
    >
      <WhatsappIcon className="w-4 h-4" />
      Contact via WhatsApp
    </a>
  </div>
</article>
