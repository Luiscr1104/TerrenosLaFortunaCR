---
// src/components/sections/WhyBuyWithUs.astro
---

<section
  class="relative py-16 md:py-24 lg:py-32 bg-gradient-to-b from-[#F7F6F2] via-[#F3F2ED] to-white overflow-hidden"
>
  <!-- Decorative background pattern -->
  <div class="absolute inset-0 bg-pattern-leaves opacity-30 mix-blend-multiply">
  </div>

  <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16 lg:mb-20">
      <div
        class="inline-flex items-center gap-2 bg-primary-500/10 text-primary-600 px-4 py-2 rounded-full text-sm font-semibold mb-4"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
        <span>The Smart Way to Buy</span>
      </div>

      <h2
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-bold text-neutral-800 mb-4 md:mb-6 tracking-tight"
      >
        Buy Your
        <span class="text-neutral-900 font-extrabold">Costa Rica Paradise</span>
        <br class="hidden sm:block" />Without Leaving Home
      </h2>

      <p class="text-lg md:text-xl text-neutral-600 max-w-3xl mx-auto">
        We handle everything remotely with full legal protection.
        <span class="font-semibold text-primary-600"
          >You don't even need to visit</span
        > (but you'll want to).
      </p>
    </div>

    <!-- Main Feature - Remote Buying -->
    <div
      class="relative rounded-3xl p-8 md:p-12 lg:p-16 mb-12 md:mb-16 shadow-[0_25px_60px_-25px_rgba(0,0,0,0.6)] overflow-hidden"
    >
      <div
        class="absolute inset-0 bg-gradient-to-br from-[#1e7a58] via-[#165f42] to-[#0f422e]"
      >
      </div>
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.06),transparent_70%)]"
      >
      </div>
      <div
        class="relative z-10 grid md:grid-cols-2 gap-8 md:gap-12 items-center text-white"
      >
        <div class="text-white">
          <div
            class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full text-sm font-semibold mb-4"
          >
            <svg
              class="w-5 h-5 text-accent-gold"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"
              ></path>
            </svg>
            <span>100% Remote Process</span>
          </div>

          <h3
            class="text-3xl md:text-4xl lg:text-5xl font-display font-bold mb-4 md:mb-6"
          >
            Purchase from Anywhere in the World
          </h3>

          <p
            class="text-lg md:text-xl text-white/90 mb-6 md:mb-8 leading-relaxed"
          >
            No need to fly to Costa Rica. We use secure video calls, digital
            signatures, and power of attorney to complete your purchase 100%
            remotely.
          </p>

          <ul class="space-y-3 md:space-y-4">
            <li class="flex items-start gap-3">
              <svg
                class="w-6 h-6 text-accent-gold flex-shrink-0 mt-1"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-base md:text-lg"
                >Virtual property tours with drone footage</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-6 h-6 text-accent-gold flex-shrink-0 mt-1"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-base md:text-lg"
                >Complete legal due diligence handled by our attorneys</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-6 h-6 text-accent-gold flex-shrink-0 mt-1"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-base md:text-lg"
                >Secure digital signing and fund transfers</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-6 h-6 text-accent-gold flex-shrink-0 mt-1"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-base md:text-lg"
                >Property titled in your name before final payment</span
              >
            </li>
          </ul>
        </div>

        <div class="relative">
          <div
            class="bg-white/10 backdrop-blur-md border-2 border-white/20 rounded-2xl p-6 md:p-8"
          >
            <div class="aspect-video rounded-xl overflow-hidden mb-4 relative">
              <video
                id="property-video"
                autoplay
                muted
                playsinline
                class="absolute inset-0 w-full h-full object-cover"></video>
            </div>
            <p class="text-white text-center text-sm md:text-base font-medium">
              Schedule your virtual property tour today
            </p>
          </div>
        </div>

        <script>
          // Lista de videos locales (en /public)
          const videos = ["/catarata.mp4", "/cayac.mov", "/sendero.mp4"];

          const videoElement = document.getElementById(
            "property-video",
          ) as HTMLVideoElement;

          if (videoElement) {
            let currentIndex = 0;

            // Carga el primer video
            videoElement.src = videos[currentIndex];

            // Cuando termine un video, pasa al siguiente
            videoElement.addEventListener("ended", () => {
              currentIndex = (currentIndex + 1) % videos.length; // vuelve al inicio al terminar
              videoElement.src = videos[currentIndex];
              videoElement.play();
            });
          }
        </script>

        <!-- Floating trust badge -->
        <div
          class="absolute -bottom-4 -right-4 bg-accent-gold text-white px-4 md:px-6 py-2 md:py-3 rounded-full shadow-xl text-xs md:text-sm font-bold"
        >
          ✓ Secure & Legal
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Key Benefits Grid -->

<!-- CTA -->
<div class="mt-12 md:mt-16 text-center">
  <a
    href="https://wa.me/50689354697?text=Hello,%20I%20want%20to%20learn%20more%20about%20remote%20purchasing"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 bg-gradient-to-r from-[#1e7a58] to-[#165f42] text-white border-2 border-[#D4AF37]/30 px-8 py-4
           rounded-lg font-bold text-lg tracking-wide shadow-[0_8px_24px_rgba(30,122,88,0.4)]
           hover:from-[#165f42] hover:to-[#0f422e] hover:border-[#D4AF37] hover:shadow-[0_0_30px_rgba(212,175,55,0.5)]
           transition-all duration-300 hover:-translate-y-1"
  >
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
      <path
        d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.96 9.96 0 0 0 1.332 4.993L2 22l5.083-1.334a9.96 9.96 0 0 0 4.928 1.317h.004a9.99 9.99 0 0 0 9.99-9.982C22.002 6.666 17.522 2 12.012 2zm0 18.288h-.004a8.27 8.27 0 0 1-4.22-1.157l-.302-.18-3.138.823.838-3.058-.196-.313a8.28 8.28 0 0 1-1.27-4.417c.002-4.57 3.725-8.287 8.29-8.287 2.214 0 4.295.863 5.86 2.428a8.26 8.26 0 0 1 2.433 5.865c-.003 4.568-3.725 8.286-8.29 8.296zm4.538-6.205c-.248-.124-1.472-.726-1.7-.81-.226-.082-.392-.123-.556.124-.166.248-.642.81-.787.974-.144.166-.29.186-.537.062-.248-.125-1.047-.386-1.994-1.23-1.74-1.55-2.07-2.48-2.31-2.88-.23-.39-.18-.56.05-.78.21-.19.46-.49.69-.74.23-.25.3-.42.45-.7.15-.27.07-.52-.04-.73-.11-.2-.56-2.28-.99-2.67-.3-.26-.64-.23-.87-.23-.23 0-.5.08-.76.36-.26.29-1 .98-1 2.38s1.02 2.76 1.16 2.95c.14.19 2 3.06 4.85 4.29 2.84 1.23 2.84.82 3.36.76.51-.06 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.16-.48-.28z"
      ></path>
    </svg>
    Start Your Remote Purchase Today
  </a>
  <p class="mt-4 text-sm text-neutral-600">
    Free consultation • No obligation • Response within 1 hour
  </p>
</div>
