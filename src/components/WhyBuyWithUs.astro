---
import WhatsappIcon from "./WhatsappIcon.astro";
---

<section class="relative py-16 md:py-24 lg:py-28 bg-white overflow-hidden">
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(26,74,46,0.05),transparent_60%)] pointer-events-none"
  ></div>

  <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16">
      <div
        class="inline-flex items-center gap-2 bg-[#1a4a2e]/10 text-[#1a4a2e] border border-[#1a4a2e]/20 px-4 py-2 rounded-full text-sm font-semibold mb-4"
      >
        <span class="inline-block w-2 h-2 rounded-full bg-[#1a4a2e]"></span>
        Your Partners in Costa Rica
      </div>

      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-display font-bold text-[#0d2218] mb-4 tracking-tight"
      >
        Buy With Confidence —
        <span class="text-[#1a4a2e]"> We Handle Everything</span>
      </h2>

      <p class="text-lg text-neutral-600 max-w-3xl mx-auto">
        Buying land in another country can feel overwhelming. We make it simple,
        safe, and personal — so you can focus on imagining your new life in
        paradise.
      </p>
    </div>

    <!-- Main Feature Card -->
    <div
      class="relative rounded-3xl overflow-hidden shadow-[0_25px_60px_-20px_rgba(0,0,0,0.45)] mb-12 md:mb-14"
    >
      <div
        class="absolute inset-0 bg-gradient-to-br from-[#1a4a2e] via-[#0f3520] to-[#0d2218]"
      ></div>
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(212,175,55,0.08),transparent_60%)]"
      ></div>

      <div
        class="relative z-10 grid md:grid-cols-2 gap-8 md:gap-12 items-center p-8 md:p-12 lg:p-16 text-white"
      >
        <!-- Left: Content -->
        <div>
          <div
            class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm px-4 py-2 rounded-full text-sm font-semibold mb-5"
          >
            <svg
              class="w-4 h-4 text-[#D4AF37]"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            From First Message to Your Deed
          </div>

          <h3
            class="text-3xl md:text-4xl font-display font-bold mb-5 leading-tight"
          >
            We're With You Every Step of the Way
          </h3>

          <p class="text-lg text-white/85 mb-8 leading-relaxed">
            You don't need to fly to Costa Rica, navigate a foreign legal system
            alone, or trust someone you've never met. Luis and José guide you
            through every detail — in plain English, with full transparency.
          </p>

          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-[#D4AF37] flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-base text-white/90"
                >Live video tours — walk the land before you commit</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-[#D4AF37] flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-base text-white/90"
                >Costa Rican notary verifies every title and boundary</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-[#D4AF37] flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-base text-white/90"
                >Licensed escrow holds your funds until title transfers to you</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-[#D4AF37] flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-base text-white/90"
                >Digital closing — no flights required, no bureaucracy, no stress</span
              >
            </li>
          </ul>
        </div>

        <!-- Right: Video -->
        <div class="relative">
          <div
            class="bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-5"
          >
            <div class="aspect-video rounded-xl overflow-hidden mb-4 relative">
              <lite-youtube
                videoid="kHQ4PgCurc8"
                nocookie
                params="autoplay=1&mute=1&controls=0&loop=1&playlist=kHQ4PgCurc8&playsinline=1&rel=0"
                class="absolute inset-0 w-full h-full"
                style="background-image: url('https://i.ytimg.com/vi/kHQ4PgCurc8/maxresdefault.jpg');"
              >
              </lite-youtube>
            </div>
            <p class="text-white/80 text-center text-sm font-medium">
              📹 José's latest drone tour — La Fortuna, Costa Rica
            </p>
          </div>

          <div
            class="absolute -bottom-3 -right-3 bg-[#D4AF37] text-[#0d2218] px-5 py-2 rounded-full shadow-xl text-xs font-bold tracking-wide uppercase"
          >
            ✓ Verified & Secure
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <a
        href="https://wa.me/50689354697?text=Hello,%20I%20want%20to%20learn%20more%20about%20buying%20property%20in%20La%20Fortuna"
        target="_blank"
        rel="noopener noreferrer"
        data-wa-location="why-buy-with-us"
        class="inline-flex items-center gap-2 bg-[#1a4a2e] hover:bg-[#0d2218] text-white border-2 border-[#D4AF37]/40 hover:border-[#D4AF37] px-8 py-4 rounded-xl font-bold text-lg shadow-[0_8px_24px_rgba(26,74,46,0.4)] hover:shadow-[0_0_30px_rgba(212,175,55,0.35)] transition-all duration-300 hover:-translate-y-0.5"
      >
        <WhatsappIcon className="w-5 h-5" />
        Book Your Free Consultation
      </a>
      <p class="mt-4 text-sm text-neutral-500">
        Free · No pressure · Response within a few hours
      </p>
    </div>
  </div>
</section>

<style>
  lite-youtube::before,
  lite-youtube > .lty-playbtn {
    display: none !important;
  }
</style>
