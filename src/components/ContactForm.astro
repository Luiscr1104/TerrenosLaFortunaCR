---
import ChapterMarker from "./editorial/ChapterMarker.astro";

interface Props {
  image?: string;
  accentGold?: string;
  accentGreen?: string;
}

const {
  image = "https://imagedelivery.net/Lh5ivcu1Gl9SRBAdYRSP2g/984f3b88-418c-42e0-8a13-ca8f69ce6900/public",
  accentGold = "#C9A24E",
  accentGreen = "#1a4a2e",
} = Astro.props;
---

<section id="contact" class="relative py-20 bg-[#F2EBDA] overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(201,162,78,0.06),transparent_60%)] pointer-events-none"></div>

  <!-- Header -->
  <div class="text-center mb-14 md:mb-16 px-4">
    <ChapterMarker numeral="Ⅵ" label="Begin the Conversation" theme="light" />

    <h2
      class="text-4xl sm:text-5xl md:text-6xl font-bold text-[#0d2218] mb-4 md:mb-5 tracking-tight leading-tight"
      style="font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);"
    >
      Find Your
      <span class="italic text-[#1a4a2e]"> Costa Rica Property</span>
      <span class="block text-3xl sm:text-4xl font-normal mt-1">With Expert Guidance</span>
    </h2>

    <p class="text-base md:text-lg text-[#2a2520]/65 max-w-2xl mx-auto" style="font-family: var(--font-sans, Inter, system-ui);">
      Full legal protection and remote purchase available.
      <span class="font-semibold text-[#1a4a2e]">Our team makes it effortless.</span>
    </p>
  </div>

  <!-- Grid principal -->
  <div
    class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-stretch"
  >
    <!-- Imagen -->
    <div
      class="relative rounded-3xl overflow-hidden border border-neutral-200 shadow-[0_14px_40px_-20px_rgba(0,0,0,0.25)]"
    >
      <img
        src={image}
        alt="Costa Rica luxury property"
        class="w-full h-[420px] md:h-[520px] lg:h-[600px] object-cover"
        loading="lazy"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/40 via-black/20 to-transparent"
      >
      </div>
      <div class="absolute bottom-5 left-6">
        <span
          class="rounded-full bg-white/90 backdrop-blur px-4 py-1.5 text-sm font-medium text-neutral-800 shadow"
        >
          La Fortuna • Costa Rica
        </span>
      </div>
    </div>

    <!-- Formulario -->
    <div
      class="rounded-3xl border border-[#C9A24E]/20 bg-white shadow-[0_14px_40px_-20px_rgba(0,0,0,0.15)] p-8 lg:p-10"
    >
      <h3
        class="text-2xl md:text-3xl font-bold text-[#0d2218] mb-3"
        style="font-family: var(--font-display, ‘Cormorant Garamond’, Georgia, serif);"
      >
        Let’s Find Your Dream Property
      </h3>
      <p class="text-[#2a2520]/60 mb-6 italic text-sm" style="font-family: var(--font-display, ‘Cormorant Garamond’, Georgia, serif);">
        Tell us about your vision — we’ll match you with the perfect land or
        home in La Fortuna and guide you through every step.
      </p>

      <form id="contact-form" class="space-y-4">
        <!-- Anti-bot fields -->
        <input type="hidden" name="start_time" id="start_time" />
        <input
          type="text"
          name="website"
          style="display:none"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label
              for="firstname"
              class="block text-xs font-medium text-neutral-600 mb-1.5"
            >
              First name
            </label>
            <input
              id="firstname"
              name="firstname"
              required
              class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm outline-none
         focus:border-[color:var(--gold)] focus:ring-2 focus:ring-[color:var(--gold)]/25 transition"
              style={`--gold:${accentGold}`}
              placeholder="John"
            />
          </div>
          <div>
            <label
              for="lastname"
              class="block text-xs font-medium text-neutral-600 mb-1.5"
            >
              Last name
            </label>
            <input
              id="lastname"
              name="lastname"
              required
              class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm outline-none
         focus:border-[color:var(--gold)] focus:ring-2 focus:ring-[color:var(--gold)]/25 transition"
              style={`--gold:${accentGold}`}
              placeholder="Doe"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label
              for="email"
              class="block text-xs font-medium text-neutral-600 mb-1.5"
            >
              Email
            </label>
            <input
              id="email"
              type="email"
              name="email"
              required
              class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm outline-none
         focus:border-[color:var(--gold)] focus:ring-2 focus:ring-[color:var(--gold)]/25 transition"
              style={`--gold:${accentGold}`}
              placeholder="john@example.com"
            />
          </div>
          <div>
            <label
              for="phone"
              class="block text-xs font-medium text-neutral-600 mb-1.5"
            >
              Phone / WhatsApp
            </label>
            <input
              id="phone"
              name="phone"
              class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm outline-none
         focus:border-[color:var(--gold)] focus:ring-2 focus:ring-[color:var(--gold)]/25 transition"
              style={`--gold:${accentGold}`}
              placeholder="+506 8935 4697"
            />
          </div>
        </div>

        <div>
          <label
            for="interest"
            class="block text-xs font-medium text-neutral-600 mb-1.5"
          >
            Interest
          </label>
          <select
            id="interest"
            name="interest"
            required
            class="w-full rounded-xl border border-neutral-200 bg-white px-3 py-2.5 text-sm outline-none
       focus:border-[color:var(--gold)] focus:ring-2 focus:ring-[color:var(--gold)]/25 transition"
            style={`--gold:${accentGold}`}
          >
            <option value="home">Home / Villa</option>
            <option value="land">Land / Lots</option>
            <option value="retirement">Retirement Property</option>
            <option value="investment">Investment Property</option>
          </select>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label
              for="contact_method"
              class="block text-xs font-medium text-neutral-600 mb-1.5"
            >
              Preferred Contact Method
            </label>
            <select
              id="contact_method"
              name="contact_method"
              class="w-full rounded-xl border border-neutral-200 bg-white px-3 py-2.5 text-sm outline-none
          focus:border-[color:var(--gold)] focus:ring-2 focus:ring-[color:var(--gold)]/25 transition"
              style={`--gold:${accentGold}`}
            >
              <option value="whatsapp">WhatsApp</option>
              <option value="email">Email</option>
              <option value="call">Phone Call</option>
            </select>
          </div>
          <div>
            <label
              for="timeline"
              class="block text-xs font-medium text-neutral-600 mb-1.5"
            >
              Your Timeline
            </label>
            <select
              id="timeline"
              name="timeline"
              class="w-full rounded-xl border border-neutral-200 bg-white px-3 py-2.5 text-sm outline-none
          focus:border-[color:var(--gold)] focus:ring-2 focus:ring-[color:var(--gold)]/25 transition"
              style={`--gold:${accentGold}`}
            >
              <option value="asap">As soon as possible</option>
              <option value="3-6-months">3-6 months</option>
              <option value="6-12-months">6-12 months</option>
              <option value="just-browsing">Just exploring options</option>
            </select>
          </div>
        </div>

        <div>
          <label
            for="message"
            class="block text-xs font-medium text-neutral-600 mb-1.5"
          >
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows={4}
            required
            class="w-full rounded-xl border border-neutral-200 bg-white px-3.5 py-2.5 text-sm outline-none
       focus:border-[color:var(--gold)] focus:ring-2 focus:ring-[color:var(--gold)]/25 transition"
            style={`--gold:${accentGold}`}
            placeholder="Tell us about your dream property..."></textarea>
        </div>

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <button
            type="submit"
            class="inline-flex justify-center items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold
       text-white bg-[color:var(--gold)] hover:brightness-[.97] active:brightness-95
       shadow-[0_10px_30px_-12px_rgba(0,0,0,0.35)] transition cursor-pointer"
            style={`--gold:${accentGold}`}
          >
            Request Consultation ↗
          </button>

          <a
            href="https://wa.me/50689354697?text=Hola!%20Estoy%20interesado(a)%20en%20propiedades%20en%20La%20Fortuna.%20¿Podr%C3%ADan%20enviarme%20opciones%20y%20m%C3%A1s%20informaci%C3%B3n?"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex justify-center items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold
       text-white bg-[color:var(--green)] hover:brightness-105 active:brightness-95 transition"
            style={`--green:${accentGreen}`}
          >
            WhatsApp Now
          </a>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  // Set start time when page loads
  document.addEventListener("DOMContentLoaded", () => {
    const startTimeInput = document.getElementById(
      "start_time",
    ) as HTMLInputElement;
    if (startTimeInput) {
      startTimeInput.value = Date.now().toString();
    }

    // Handle form submission
    const form = document.getElementById("contact-form") as HTMLFormElement;
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const submitButton = form.querySelector(
          'button[type="submit"]',
        ) as HTMLButtonElement;
        const originalText = submitButton.innerHTML;

        // Disable button and show loading state
        submitButton.disabled = true;
        submitButton.innerHTML = "Sending...";

        try {
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());

          const response = await fetch("/api/contact", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(data),
          });

          const result = await response.json();

          if (response.ok && result.success) {
            // Success - redirect with success parameter
            window.location.href = "/thank-you";
          } else {
            // Error
            alert(result.message || "Error sending message. Please try again.");
            submitButton.disabled = false;
            submitButton.innerHTML = originalText;
          }
        } catch (error) {
          console.error("Error:", error);
          alert(
            "Error sending message. Please try again or contact us via WhatsApp.",
          );
          submitButton.disabled = false;
          submitButton.innerHTML = originalText;
        }
      });
    }
  });
</script>
