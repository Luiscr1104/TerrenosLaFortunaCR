---
import Layout from "../layouts/Layout.astro";
import WhatsappIcon from "../components/WhatsappIcon.astro";
---

<Layout title="Thank You | BuyLandCR" description="Your guide is on the way.">
    <main
        class="min-h-screen flex items-center justify-center bg-gradient-to-br from-neutral-900 via-neutral-800 to-neutral-900 px-4 relative overflow-hidden"
    >
        <!-- Background Effects -->
        <div
            class="absolute top-0 right-0 w-[500px] h-[500px] bg-green-500/10 rounded-full blur-[120px] -mr-64 -mt-64"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-yellow-500/5 rounded-full blur-[100px] -ml-48 -mb-48"
        >
        </div>

        <div class="relative z-10 max-w-2xl w-full text-center">
            <!-- Success Animation Circle -->
            <div class="mb-8 mx-auto w-24 h-24 relative">
                <div
                    class="absolute inset-0 bg-green-500/20 rounded-full animate-ping"
                >
                </div>
                <div
                    class="relative w-full h-full bg-green-500 rounded-full flex items-center justify-center shadow-[0_0_40px_rgba(34,197,94,0.4)]"
                >
                    <svg
                        class="w-12 h-12 text-white"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="3"
                            d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
            </div>

            <h1
                class="text-4xl md:text-6xl font-display font-bold text-white mb-6 tracking-tight"
            >
                Message Received.
            </h1>

            <p class="text-xl md:text-2xl text-neutral-300 font-light mb-12">
                Check your inbox, your guide is on the way.
            </p>

            <div
                class="bg-white/5 backdrop-blur-md border border-white/10 rounded-3xl p-8 mb-8"
            >
                <p
                    class="text-neutral-400 text-sm uppercase tracking-widest mb-4"
                >
                    Looking for immediate options?
                </p>
                <h3 class="text-xl text-white font-medium mb-6">
                    Don't want to wait? Message me on WhatsApp for the current
                    inventory.
                </h3>

                <a
                    href="https://wa.me/50689354697?text=Hi!%20I%20just%20requested%20the%20guide%20but%20I'd%20love%20to%20see%20current%20inventory%20now."
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-3 bg-green-500 hover:bg-green-400 text-white font-bold py-4 px-8 rounded-xl shadow-[0_10px_30px_rgba(34,197,94,0.3)] transition-all hover:scale-105 active:scale-95 text-lg w-full md:w-auto justify-center"
                >
                    <WhatsappIcon className="w-6 h-6" />
                    Get Instant Access on WhatsApp
                </a>
            </div>

            <a
                href="/"
                class="text-neutral-500 hover:text-white transition-colors text-sm"
            >
                ← Return to Homepage
            </a>
        </div>
    </main>
</Layout>

<script>
    // Define the type for dataLayer
    declare global {
        interface Window {
            dataLayer: any[];
        }
    }

    // Conversion Tracking
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
        event: "generate_lead",
        currency: "USD",
        value: 100.0,
    });
</script>
