---
import Layout from "../layouts/Layout.astro";

const title = "Page Not Found | BuyLandCR";
const description =
    "The page you are looking for does not exist. Return to BuyLandCR to find your perfect property in Costa Rica.";
---

<Layout title={title} description={description} ogType="website">
    <main
        class="relative min-h-screen flex items-center justify-center overflow-hidden bg-[#052e14]"
    >
        <!-- Background Image with Overlay -->
        <div class="absolute inset-0 z-0">
            <img
                src="/sanrafael.webp"
                alt="La Fortuna rainforest landscape"
                class="w-full h-full object-cover object-top opacity-40 mix-blend-overlay"
            />
            <div
                class="absolute inset-0 bg-gradient-to-t from-[#052e14] via-[#052e14]/80 to-transparent"
            >
            </div>
        </div>

        <!-- Content -->
        <div
            class="relative z-10 max-w-2xl mx-auto px-6 text-center text-white"
        >
            <p
                class="text-[color:var(--gold)] font-bold tracking-[0.2em] uppercase mb-4 animate-fade-in"
            >
                Error 404
            </p>

            <h1
                class="text-5xl md:text-7xl lg:text-8xl font-bold mb-6 tracking-tight leading-none text-white drop-shadow-lg"
            >
                Lost in the <br class="hidden md:block" />
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-[#D4AF37] to-[#F5D77C]"
                >
                    Jungle?
                </span>
            </h1>

            <p
                class="text-lg md:text-xl text-neutral-300 mb-10 leading-relaxed max-w-lg mx-auto"
            >
                The path you are looking for has been overgrown by the
                rainforest. But don't worry, we can guide you back to the best
                properties in La Fortuna.
            </p>

            <div
                class="flex flex-col sm:flex-row items-center justify-center gap-4"
            >
                <a
                    href="/"
                    class="w-full sm:w-auto px-8 py-4 bg-[color:var(--gold)] text-[#052e14] font-bold rounded-xl shadow-[0_0_20px_rgba(212,175,55,0.3)] hover:shadow-[0_0_30px_rgba(212,175,55,0.5)] hover:scale-105 transition-all duration-300"
                >
                    Return Home
                </a>
                <a
                    href="/properties"
                    class="w-full sm:w-auto px-8 py-4 border border-white/20 bg-white/5 backdrop-blur-sm text-white font-semibold rounded-xl hover:bg-white/10 hover:border-white/40 transition-all duration-300"
                >
                    View Properties
                </a>
            </div>
        </div>

        <!-- Decorative Elements -->
        <div
            class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-[#052e14] to-transparent z-0"
        >
        </div>
    </main>
</Layout>

<style>
    :root {
        --gold: #d4af37;
    }

    .animate-fade-in {
        animation: fadeIn 1s ease-out forwards;
        opacity: 0;
        transform: translateY(10px);
    }

    @keyframes fadeIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
