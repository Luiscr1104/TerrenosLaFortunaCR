---
import Hero from "../components/Hero.astro";
import Layout from "../layouts/Layout.astro";
import WhyBuyWithUs from "../components/WhyBuyWithUs.astro";
import FeaturedProperties from "../components/FeaturedProperties.astro";
import ContactForm from "../components/ContactForm.astro";
import TrustGuarantees from "../components/TrustGuarantees.astro";
import HowItWorks from "../components/HowItWorks.astro";
import FeaturedBlogs from "../components/FeaturedBlogs.astro";
import ScrollingBanner from "../components/ScrollingBanner.astro";
import MidPageCTA from "../components/MidPageCTA.astro";
import VideoSection from "../components/VideoSection.astro";
import WildlifeCinema from "../components/WildlifeCinema.astro";
import NatureMosaic from "../components/NatureMosaic.astro";
---

<Layout preloadImage="/images/catarata.webp">

  <!-- 1. HOOK: Hero — Ken Burns nature slideshow -->
  <Hero />

  <!-- Nature + trust signals on dark -->
  <ScrollingBanner theme="dark" speed="normal" />

  <!-- 2. PRODUCT: Properties -->
  <FeaturedProperties />

  <!-- 3. NATURE MOMENT: Wildlife Cinema (parallax + floating butterflies) -->
  <WildlifeCinema />

  <!-- Cintillo: property types on cream -->
  <ScrollingBanner theme="light" speed="slow" />

  <!-- 4. CINEMATIC BREAK: San Rafael valley panoramic with quote -->
  <VideoSection
    quote="Every morning begins with the volcano."
    ctaLabel="Explore Available Properties"
    ctaHref="/properties"
  />

  <!-- 5. SOCIAL PROOF: Guarantees -->
  <TrustGuarantees />

  <!-- 6. AUTHORITY: Why Us? -->
  <WhyBuyWithUs />

  <!-- Mid-page conversion CTA -->
  <MidPageCTA />

  <!-- 7. PROCESS: How It Works -->
  <HowItWorks />

  <!-- 8. NATURE MOSAIC: Full-width bento grid of all nature images -->
  <NatureMosaic />

  <!-- Cintillo: property categories on gold -->
  <ScrollingBanner theme="gold" speed="normal" items={[
    "🌋 Volcano View Lots",
    "🌿 Jungle & Privacy",
    "💧 Riverside Parcels",
    "🏠 Turnkey Villas",
    "📈 Investment Land",
    "🌱 Eco Retreats",
    "♨️ Hot Springs Nearby",
    "☁️ Cloud Forest Edge",
    "🔒 Gated Communities",
    "⚡ Off-Grid Potential",
  ]} />

  <!-- 9. ACTION: Contact Form -->
  <ContactForm />

  <!-- 10. SEO & EDUCATION -->
  <FeaturedBlogs />

</Layout>
