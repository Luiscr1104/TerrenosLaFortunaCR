---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const title = "Real Estate & Lifestyle Blog | La Fortuna Costa Rica";
const description =
    "Latest insights on buying land, retirement, and living in La Fortuna, Costa Rica. Expert guides on legal processes, market trends, and local lifestyle.";
---

<Layout title={title} description={description}>
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-[#052E14] via-[#063a1a] to-[#052E14] py-20 sm:py-28 overflow-hidden">
        <!-- Background decorations -->
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-[#D4AF37]/10 rounded-full blur-[120px] -z-10"></div>
        <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-[#D4AF37]/5 rounded-full blur-[100px] -z-10"></div>
        
        <div class="mx-auto max-w-7xl px-6 lg:px-8 relative">
            <div class="mx-auto max-w-3xl text-center">
                <!-- Badge -->
                <div class="inline-flex items-center gap-2 bg-[#D4AF37]/20 backdrop-blur-sm text-[#F5D77C] font-semibold text-sm px-5 py-2 rounded-full border border-[#D4AF37]/40 mb-6 shadow-lg">
                    <span class="inline-block h-2.5 w-2.5 rounded-full bg-[#D4AF37] animate-pulse"></span>
                    Latest Insights
                </div>
                
                <h1 class="text-4xl sm:text-5xl md:text-6xl font-display font-black text-white mb-6 tracking-tight leading-tight">
                    Your Guide to <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#F5D77C] to-[#D4AF37]">Paradise</span>
                </h1>
                <p class="text-lg md:text-xl text-neutral-200 leading-relaxed max-w-2xl mx-auto font-medium">
                    Expert advice, market insights, and local stories to help you make the best decisions about your Costa Rican dream.
                </p>
            </div>
        </div>
    </section>

    <!-- Blog Grid -->
    <section class="bg-white py-20 sm:py-24 relative">
        <!-- Subtle background pattern -->
        <div class="absolute inset-0 opacity-[0.03] bg-[radial-gradient(circle_at_30%_20%,#D4AF37,transparent_50%)]"></div>
        
        <div class="mx-auto max-w-7xl px-6 lg:px-8 relative">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
                {posts.map((post) => (
                    <article class="group relative rounded-3xl border border-[#052E14]/10 bg-white shadow-[0_10px_40px_-15px_rgba(0,0,0,0.15)] hover:shadow-[0_20px_50px_-12px_rgba(212,175,55,0.25)] transition-all duration-500 overflow-hidden hover:-translate-y-1">
                        <!-- Image -->
                        <div class="relative aspect-[16/10] overflow-hidden">
                            <img
                                src={post.data.image}
                                alt={post.data.title}
                                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                                loading="lazy"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-black/0 to-transparent"></div>
                            
                            <!-- Category Badge -->
                            {post.data.category && (
                                <div class="absolute top-4 left-4 rounded-full bg-white/95 backdrop-blur-sm text-[#052E14] text-xs font-bold px-4 py-2 shadow-lg border border-[#D4AF37]/20">
                                    {post.data.category}
                                </div>
                            )}
                        </div>

                        <!-- Content -->
                        <div class="p-6 lg:p-7">
                            <!-- Meta -->
                            <div class="flex items-center gap-3 text-xs text-neutral-500 mb-4">
                                <time datetime={post.data.date.toISOString()} class="flex items-center gap-1.5 font-medium">
                                    <svg class="w-4 h-4 text-[#D4AF37]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                    {post.data.date.toLocaleDateString("en-US", {
                                        year: "numeric",
                                        month: "short",
                                        day: "numeric",
                                    })}
                                </time>
                                {post.data.readingTime && (
                                    <>
                                        <span class="text-neutral-300">•</span>
                                        <span class="flex items-center gap-1.5 font-medium">
                                            <svg class="w-4 h-4 text-[#D4AF37]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                            </svg>
                                            {post.data.readingTime}
                                        </span>
                                    </>
                                )}
                            </div>

                            <!-- Title -->
                            <h3 class="text-xl md:text-2xl font-display font-bold text-[#052E14] leading-tight mb-3 group-hover:text-[#D4AF37] transition-colors line-clamp-2">
                                <a href={`/blog/${post.slug}`} class="focus:outline-none focus:ring-2 focus:ring-[#D4AF37]/50 rounded">
                                    <span class="absolute inset-0"></span>
                                    {post.data.title}
                                </a>
                            </h3>

                            <!-- Excerpt -->
                            <p class="text-neutral-700 leading-relaxed line-clamp-3 mb-5">
                                {post.data.excerpt}
                            </p>

                            <!-- Read More -->
                            <div class="flex items-center justify-between pt-4 border-t border-neutral-100">
                                <span class="inline-flex items-center gap-2 text-[#052E14] font-bold text-sm group-hover:text-[#D4AF37] transition-colors">
                                    Read Article
                                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M13.172 12l-4.95-4.95 1.414-1.414L16 12l-6.364 6.364-1.414-1.414z"></path>
                                    </svg>
                                </span>
                                <div class="h-2 w-2 rounded-full bg-[#D4AF37] shadow-[0_0_12px_rgba(212,175,55,0.6)]"></div>
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <style>
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .animate-pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
    </style>
</Layout>
