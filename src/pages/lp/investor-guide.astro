---
import Layout from "../../layouts/Layout.astro";
import ContactForm from "../../components/ContactForm.astro";
import { getAllProperties, formatPriceUSD } from "../../lib/properties";

const properties = getAllProperties().slice(0, 3);

const title = "Investor's Guide to La Fortuna, Costa Rica | BuyLandCR";
const description =
    "Download our free comprehensive guide on how to safely invest in land and properties in La Fortuna. Legal requirements, ROI analysis, and step-by-step process.";

const coverImage =
    "https://imagedelivery.net/Lh5ivcu1Gl9SRBAdYRSP2g/32994a26-b26b-450d-4c7f-f3ab849aee00/public";
---

<Layout title={title} description={description}>
    <style>
        .premium-gradient {
            background: linear-gradient(135deg, #052e14 0%, #0d4a22 100%);
        }
        .text-glow {
            text-shadow: 0 0 20px rgba(22, 163, 74, 0.3);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px border rgba(255, 255, 255, 0.1);
        }
        .floating {
            animation: float 6s ease-in-out infinite;
        }
        @keyframes float {
            0% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-20px);
            }
            100% {
                transform: translateY(0px);
            }
        }
    </style>

    <!-- Hero Section: Ultra Premium -->
    <section
        class="relative min-h-[90vh] flex items-center overflow-hidden premium-gradient pt-20"
    >
        <!-- Animated background accents -->
        <div
            class="absolute top-0 right-0 w-[500px] h-[500px] bg-green-500/10 rounded-full blur-[120px] -mr-64 -mt-64"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-yellow-500/5 rounded-full blur-[100px] -ml-48 -mb-48"
        >
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-12">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <!-- Left Content -->
                <div
                    class="animate-in fade-in slide-in-from-left duration-1000"
                >
                    <div
                        class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-green-400 text-sm font-bold tracking-widest uppercase mb-8 backdrop-blur-md"
                    >
                        <span class="relative flex h-2 w-2">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
                            ></span>
                            <span
                                class="relative inline-flex rounded-full h-2 w-2 bg-green-500"
                            ></span>
                        </span>
                        2024 Exclusive Report
                    </div>

                    <h1
                        class="text-5xl md:text-7xl font-display font-black text-white mb-8 leading-[1.1] text-glow"
                    >
                        Secure <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-200"
                            >15%+ Annual ROI</span
                        > in the Arenal Market
                    </h1>

                    <p
                        class="text-xl md:text-2xl text-white/80 mb-10 leading-relaxed font-light"
                    >
                        Master the "Regla del 2%" used by top international
                        investors. Access the same legal frameworks and
                        proprietary data used to secure premium land in <span
                            class="text-white font-medium italic underline decoration-green-500/50"
                            >La Fortuna</span
                        >.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-6">
                        <a
                            href="#contact"
                            class="px-8 py-5 bg-green-600 hover:bg-green-500 text-white rounded-2xl font-bold text-lg shadow-[0_20px_50px_-10px_rgba(22,163,74,0.5)] transition-all hover:scale-105 active:scale-95 text-center"
                        >
                            Download Free Guide ↓
                        </a>
                        <div class="flex items-center gap-4 text-white/60">
                            <div class="flex -space-x-3">
                                {
                                    [1, 2, 3, 4].map((i) => (
                                        <div class="w-10 h-10 rounded-full border-2 border-green-900 bg-neutral-800 flex items-center justify-center text-[10px] font-bold">
                                            <img
                                                src={`https://i.pravatar.cc/100?u=${i}`}
                                                class="rounded-full w-full h-full object-cover"
                                            />
                                        </div>
                                    ))
                                }
                            </div>
                            <span class="text-sm">Joined by 500+ investors</span
                            >
                        </div>
                    </div>
                </div>

                <!-- Right Content: The Visual Hook -->
                <div class="relative lg:block">
                    <div class="relative z-10 floating">
                        <img
                            src={coverImage}
                            alt="Investor's Guide 2024 Cover"
                            class="w-full max-w-[480px] mx-auto rounded-[2rem] shadow-[0_50px_100px_-20px_rgba(0,0,0,0.6)] border-[12px] border-white/5"
                        />

                        <!-- Floating Achievement Badge -->
                        <div
                            class="absolute -bottom-10 -left-10 bg-white p-6 rounded-3xl shadow-2xl animate-in zoom-in duration-700 delay-500 hidden md:block"
                        >
                            <div
                                class="text-neutral-900 font-bold text-3xl mb-1"
                            >
                                100%
                            </div>
                            <div
                                class="text-neutral-500 text-xs uppercase tracking-tighter"
                            >
                                Legal Transparency
                            </div>
                        </div>
                    </div>

                    <!-- Decorative Background element -->
                    <div
                        class="absolute inset-0 bg-green-500/20 blur-[100px] scale-110 -z-10"
                    >
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Value Propositions with Glassmorphism -->
    <section
        class="py-24 bg-[#052E14] relative overflow-hidden border-t border-white/5"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-16">
                <h2
                    class="text-3xl md:text-5xl font-display font-bold text-white mb-4"
                >
                    Inside the Guide
                </h2>
                <div class="w-24 h-1 bg-[#D4AF37] mx-auto rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
                {
                    [
                        {
                            title: "The 2% Rule",
                            desc: "How to identify properties that generate enough rental income to cover all expenses and more.",
                            icon: "💎",
                        },
                        {
                            title: "ROI Hotspots",
                            desc: "Discover which areas in La Fortuna are seeing 15%+ annual appreciation in 2024.",
                            icon: "📈",
                        },
                        {
                            title: "Legal Protection",
                            desc: "The expat's guide to Title Assurance, Digital Escrow, and safe remote signings.",
                            icon: "🛡️",
                        },
                    ].map((item) => (
                        <div class="glass-card p-10 rounded-[2.5rem] hover:bg-white/5 transition-colors border border-white/5 group text-center md:text-left">
                            <div class="text-5xl mb-6 group-hover:scale-110 transition-transform inline-block">
                                {item.icon}
                            </div>
                            <h3 class="text-2xl font-bold text-white mb-4">
                                {item.title}
                            </h3>
                            <p class="text-white/60 leading-relaxed font-light">
                                {item.desc}
                            </p>
                        </div>
                    ))
                }
            </div>

            <!-- Comparison Table -->
            <div class="max-w-4xl mx-auto">
                <div
                    class="glass-card rounded-[3rem] overflow-hidden border border-white/10 shadow-2xl relative"
                >
                    <div class="absolute top-0 right-0 p-4">
                        <span
                            class="text-[10px] font-black text-[#D4AF37] uppercase tracking-[0.3em] opacity-40"
                            >Benchmark v2.4</span
                        >
                    </div>
                    <div class="p-10 border-b border-white/10 bg-white/5">
                        <h3 class="text-2xl font-bold text-white text-center">
                            Market Performance 2024
                        </h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="bg-white/5 text-[#D4AF37]">
                                    <th
                                        class="px-8 py-5 uppercase tracking-widest text-[10px] font-black"
                                        >Region</th
                                    >
                                    <th
                                        class="px-8 py-5 uppercase tracking-widest text-[10px] font-black"
                                        >Avg. ROI</th
                                    >
                                    <th
                                        class="px-8 py-5 uppercase tracking-widest text-[10px] font-black"
                                        >Stability</th
                                    >
                                    <th
                                        class="px-8 py-5 uppercase tracking-widest text-[10px] font-black"
                                        >Growth</th
                                    >
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5">
                                <tr
                                    class="group/row hover:bg-white/5 transition-colors"
                                >
                                    <td
                                        class="px-8 py-6 text-[#D4AF37] font-bold"
                                        >La Fortuna</td
                                    >
                                    <td class="px-8 py-6 text-white font-medium"
                                        >12-18%</td
                                    >
                                    <td class="px-8 py-6 text-white/80"
                                        >High (Year-round)</td
                                    >
                                    <td class="px-8 py-6 text-white/80"
                                        >Explosive</td
                                    >
                                </tr>
                                <tr
                                    class="opacity-50 hover:opacity-100 transition-opacity"
                                >
                                    <td class="px-8 py-6 text-white italic"
                                        >Nosara</td
                                    >
                                    <td class="px-8 py-6 text-white">6-8%</td>
                                    <td class="px-8 py-6 text-white/60"
                                        >Seasonal</td
                                    >
                                    <td class="px-8 py-6 text-white/60"
                                        >Saturated</td
                                    >
                                </tr>
                                <tr
                                    class="opacity-50 hover:opacity-100 transition-opacity border-none"
                                >
                                    <td class="px-8 py-6 text-white italic"
                                        >Tamarindo</td
                                    >
                                    <td class="px-8 py-6 text-white">5-7%</td>
                                    <td class="px-8 py-6 text-white/60"
                                        >Seasonal</td
                                    >
                                    <td class="px-8 py-6 text-white/60"
                                        >Mature</td
                                    >
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div
                        class="p-6 bg-[#D4AF37]/10 text-center border-t border-white/5"
                    >
                        <p
                            class="text-[#D4AF37] text-xs font-bold uppercase tracking-widest"
                        >
                            Strategy: Year-round demand vs. Coastal volatility.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Teaser Property Catalog -->
    <section
        class="py-24 bg-[#052E14] border-t border-white/5 relative overflow-hidden"
    >
        <!-- Subtle background texture -->
        <div class="absolute inset-0 opacity-10 pointer-events-none">
            <div
                class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(#D4AF37_1px,transparent_1px)] [background-size:40px_40px]"
            >
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div
                class="flex flex-col md:flex-row justify-between items-end gap-6 mb-16"
            >
                <div class="max-w-xl">
                    <h2
                        class="text-3xl md:text-5xl font-display font-bold text-white mb-4"
                    >
                        Current High-Yield Opportunities
                    </h2>
                    <p class="text-white/60">
                        A sneak peek at real properties available in our
                        inventory. Fully titled, vetted, and featured in the
                        guide's investment case studies.
                    </p>
                </div>
                <a
                    href="/properties"
                    class="text-[#D4AF37] font-bold hover:text-white transition-colors inline-flex items-center gap-2 group"
                >
                    View Full Catalog <span
                        class="group-hover:translate-x-1 transition-transform"
                        >→</span
                    >
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    properties.map((prop) => (
                        <div class="group relative rounded-[2.5rem] overflow-hidden border border-white/10 glass-card">
                            <div class="aspect-[4/3] relative overflow-hidden">
                                <img
                                    src={prop.images[0]}
                                    alt={prop.title}
                                    class="w-full h-full object-cover grayscale blur-[3px] group-hover:blur-0 group-hover:grayscale-0 transition-all duration-700 scale-110 group-hover:scale-100"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-[#052E14] via-[#052E14]/20 to-transparent opacity-80" />
                                <div class="absolute top-5 left-5">
                                    <span class="px-3 py-1 rounded-full bg-[#D4AF37] text-[#052E14] text-[10px] font-black uppercase tracking-widest shadow-lg">
                                        {prop.type === "land"
                                            ? "Exclusive Land"
                                            : "Yield Asset"}
                                    </span>
                                </div>
                            </div>
                            <div class="p-8">
                                <h3 class="text-xl font-bold text-white mb-3 line-clamp-1">
                                    {prop.title}
                                </h3>
                                <p class="text-white/40 text-sm mb-6 leading-relaxed line-clamp-2">
                                    {prop.description || prop.features?.[0]}
                                </p>
                                <div class="flex items-center justify-between border-t border-white/5 pt-6">
                                    <span class="text-[#D4AF37] font-black text-2xl">
                                        {formatPriceUSD(prop.price)}
                                    </span>
                                    <span class="text-white/20 text-[10px] uppercase font-bold tracking-[0.2em]">
                                        Inquire for Private File
                                    </span>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Legal Pitfalls: Position as Expert -->
    <section
        class="py-24 bg-[#052E14] border-y border-white/5 relative overflow-hidden"
    >
        <div class="absolute inset-0 bg-red-500/5 pointer-events-none"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div>
                    <span
                        class="text-red-400 font-bold uppercase tracking-[0.3em] text-xs mb-6 block"
                        >Critical Investor Alert</span
                    >
                    <h2
                        class="text-3xl md:text-5xl font-display font-bold text-white mb-8 leading-tight"
                    >
                        3 "Hidden Traps" that cost foreign investors thousands.
                    </h2>
                    <p class="text-white/60 mb-10 leading-relaxed font-light">
                        Costa Rica is a safe haven, but skipping these steps can
                        lead to years of legal battles. Our guide reveals how to
                        bypass these critical errors:
                    </p>
                    <ul class="space-y-6">
                        <li class="flex items-start gap-4">
                            <span class="text-red-400 font-bold mt-1">✕</span>
                            <p
                                class="text-white/80 leading-relaxed font-medium"
                            >
                                Buying land without <span
                                    class="text-white border-b border-red-400/30"
                                    >Verified Digital Water Letters</span
                                > (No water = No permit).
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-red-400 font-bold mt-1">✕</span>
                            <p
                                class="text-white/80 leading-relaxed font-medium"
                            >
                                Using the <span
                                    class="text-white border-b border-red-400/30"
                                    >Seller's Attorney</span
                                > instead of an independent advocate.
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-red-400 font-bold mt-1">✕</span>
                            <p
                                class="text-white/80 leading-relaxed font-medium"
                            >
                                Failing to check <span
                                    class="text-white border-b border-red-400/30"
                                    >'Natural Heritage' (PNE)</span
                                > borders on jungle lots.
                            </p>
                        </li>
                    </ul>
                </div>
                <div
                    class="glass-card p-12 rounded-[3.5rem] border-white/5 relative overflow-hidden bg-white/[0.02]"
                >
                    <div
                        class="absolute -top-10 -right-10 w-40 h-40 bg-red-500/5 blur-3xl rounded-full"
                    >
                    </div>
                    <h3
                        class="text-2xl font-bold text-white mb-6 italic leading-relaxed"
                    >
                        "I wish I had this guide 5 years ago when I started my
                        first development here..."
                    </h3>
                    <p class="text-white/40 mb-10 leading-relaxed font-light">
                        Investing large capital shouldn't be a gamble. We built
                        this guide to ensure every buyer in La Fortuna has the
                        same protection as a local developer.
                    </p>
                    <div class="flex items-center gap-5">
                        <img
                            src="https://imagedelivery.net/Lh5ivcu1Gl9SRBAdYRSP2g/5c1a8a2a-466d-495c-3729-1a00a18f8e00/public"
                            class="w-14 h-14 rounded-full grayscale border border-white/10"
                            alt="Luis Rodríguez"
                        />
                        <div>
                            <p class="text-white font-black tracking-tight">
                                Luis Rodríguez
                            </p>
                            <p
                                class="text-[#D4AF37] text-[10px] font-black uppercase tracking-widest"
                            >
                                Arenal Specialist
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- The Form: High Impact Transition -->
    <section id="contact" class="py-24 bg-white relative">
        <div
            class="absolute top-0 inset-x-0 h-40 bg-gradient-to-b from-[#052E14] to-white"
        >
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-16">
                <div
                    class="inline-flex items-center gap-2 bg-[#052E14]/5 text-[#052E14] px-5 py-2.5 rounded-full text-xs font-black uppercase tracking-widest mb-8 border border-[#052E14]/10"
                >
                    <span
                        class="flex h-2 w-2 rounded-full bg-[#D4AF37] animate-pulse"
                    ></span>
                    Immediate Delivery
                </div>
                <h2
                    class="text-4xl md:text-6xl font-display font-black text-neutral-900 mt-2 tracking-tight"
                >
                    Access the Full Report
                </h2>
                <p
                    class="text-neutral-500 mt-6 text-lg max-w-2xl mx-auto font-light leading-relaxed"
                >
                    We'll send the <span class="font-bold text-neutral-900"
                        >54-page PDF</span
                    > and the <span class="font-bold text-neutral-900"
                        >Exclusive Inventory List</span
                    > via Email and WhatsApp within 60 seconds.
                </p>
            </div>

            <div
                class="rounded-[3rem] overflow-hidden shadow-[0_100px_150px_-50px_rgba(0,0,0,0.1)] border border-neutral-100"
            >
                <ContactForm accentGold="#D4AF37" />
            </div>
        </div>
    </section>

    <!-- Trust Bar -->
    <section class="py-20 bg-neutral-50 border-t border-neutral-100">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p
                class="text-neutral-400 font-black uppercase tracking-[0.4em] mb-12 text-[10px]"
            >
                Vetted by In-Country Legal Experts
            </p>
            <div
                class="flex flex-wrap justify-center items-center gap-12 md:gap-24 opacity-30 grayscale hover:grayscale-0 transition-all duration-700"
            >
                <span
                    class="text-xl font-black text-neutral-800 tracking-tighter"
                    >COSTA RICA LAW</span
                >
                <span
                    class="text-xl font-black text-neutral-800 tracking-tighter"
                    >DUEDILIGENCE CR</span
                >
                <span
                    class="text-xl font-black text-neutral-800 tracking-tighter"
                    >ARENAL ADVISORS</span
                >
            </div>
        </div>
    </section>
</Layout>

<style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;900&display=swap");

    h1,
    h2,
    h3,
    .font-display {
        font-family: "Outfit", sans-serif;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }
</style>
