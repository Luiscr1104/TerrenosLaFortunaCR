---
import Layout from "../../layouts/Layout.astro";
import ContactForm from "../../components/ContactForm.astro";

const title = "Investor's Guide to La Fortuna, Costa Rica | BuyLandCR";
const description =
    "Download our free comprehensive guide on how to safely invest in land and properties in La Fortuna. Legal requirements, ROI analysis, and step-by-step process.";

const coverImage =
    "https://imagedelivery.net/Lh5ivcu1Gl9SRBAdYRSP2g/32994a26-b26b-450d-4c7f-f3ab849aee00/public";
---

<Layout title={title} description={description}>
    <style>
        .premium-gradient {
            background: linear-gradient(135deg, #052e14 0%, #0d4a22 100%);
        }
        .text-glow {
            text-shadow: 0 0 20px rgba(22, 163, 74, 0.3);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px border rgba(255, 255, 255, 0.1);
        }
        .floating {
            animation: float 6s ease-in-out infinite;
        }
        @keyframes float {
            0% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-20px);
            }
            100% {
                transform: translateY(0px);
            }
        }
    </style>

    <!-- Hero Section: Ultra Premium -->
    <section
        class="relative min-h-[90vh] flex items-center overflow-hidden premium-gradient pt-20"
    >
        <!-- Animated background accents -->
        <div
            class="absolute top-0 right-0 w-[500px] h-[500px] bg-green-500/10 rounded-full blur-[120px] -mr-64 -mt-64"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-yellow-500/5 rounded-full blur-[100px] -ml-48 -mb-48"
        >
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-12">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <!-- Left Content -->
                <div
                    class="animate-in fade-in slide-in-from-left duration-1000"
                >
                    <div
                        class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-green-400 text-sm font-bold tracking-widest uppercase mb-8 backdrop-blur-md"
                    >
                        <span class="relative flex h-2 w-2">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
                            ></span>
                            <span
                                class="relative inline-flex rounded-full h-2 w-2 bg-green-500"
                            ></span>
                        </span>
                        2024 Exclusive Report
                    </div>

                    <h1
                        class="text-5xl md:text-7xl font-display font-black text-white mb-8 leading-[1.1] text-glow"
                    >
                        Master the <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-200"
                            >Costa Rica</span
                        > Real Estate Market
                    </h1>

                    <p
                        class="text-xl md:text-2xl text-white/80 mb-10 leading-relaxed font-light"
                    >
                        Stop navigating in the dark. Access the data, legal
                        frameworks, and ROI models used by top international
                        investors in <span
                            class="text-white font-medium italic underline decoration-green-500/50"
                            >La Fortuna</span
                        >.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-6">
                        <a
                            href="#contact"
                            class="px-8 py-5 bg-green-600 hover:bg-green-500 text-white rounded-2xl font-bold text-lg shadow-[0_20px_50px_-10px_rgba(22,163,74,0.5)] transition-all hover:scale-105 active:scale-95 text-center"
                        >
                            Download Free Guide ↓
                        </a>
                        <div class="flex items-center gap-4 text-white/60">
                            <div class="flex -space-x-3">
                                {
                                    [1, 2, 3, 4].map((i) => (
                                        <div class="w-10 h-10 rounded-full border-2 border-green-900 bg-neutral-800 flex items-center justify-center text-[10px] font-bold">
                                            <img
                                                src={`https://i.pravatar.cc/100?u=${i}`}
                                                class="rounded-full w-full h-full object-cover"
                                            />
                                        </div>
                                    ))
                                }
                            </div>
                            <span class="text-sm">Joined by 500+ investors</span
                            >
                        </div>
                    </div>
                </div>

                <!-- Right Content: The Visual Hook -->
                <div class="relative lg:block">
                    <div class="relative z-10 floating">
                        <img
                            src={coverImage}
                            alt="Investor's Guide 2024 Cover"
                            class="w-full max-w-[480px] mx-auto rounded-[2rem] shadow-[0_50px_100px_-20px_rgba(0,0,0,0.6)] border-[12px] border-white/5"
                        />

                        <!-- Floating Achievement Badge -->
                        <div
                            class="absolute -bottom-10 -left-10 bg-white p-6 rounded-3xl shadow-2xl animate-in zoom-in duration-700 delay-500 hidden md:block"
                        >
                            <div
                                class="text-neutral-900 font-bold text-3xl mb-1"
                            >
                                100%
                            </div>
                            <div
                                class="text-neutral-500 text-xs uppercase tracking-tighter"
                            >
                                Legal Transparency
                            </div>
                        </div>
                    </div>

                    <!-- Decorative Background element -->
                    <div
                        class="absolute inset-0 bg-green-500/20 blur-[100px] scale-110 -z-10"
                    >
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Value Propositions with Glassmorphism -->
    <section class="py-24 bg-[#031d0d] relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-16">
                <h2
                    class="text-3xl md:text-5xl font-display font-bold text-white mb-4"
                >
                    Inside the Guide
                </h2>
                <div class="w-24 h-1 bg-green-600 mx-auto rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {
                    [
                        {
                            title: "Legal Safety",
                            desc: "Understand 'Corporation vs Person' ownership and the Digital escrow process.",
                            icon: "⚖️",
                        },
                        {
                            title: "ROI Hotspots",
                            desc: "Discover which areas in La Fortuna are seeing 15%+ annual appreciation.",
                            icon: "📈",
                        },
                        {
                            title: "Tax Planning",
                            desc: "The expat's guide to property taxes and residency benefits in 2024.",
                            icon: "🏛️",
                        },
                    ].map((item) => (
                        <div class="glass-card p-10 rounded-[2.5rem] hover:bg-white/5 transition-colors border border-white/5 group">
                            <div class="text-5xl mb-6 group-hover:scale-110 transition-transform inline-block">
                                {item.icon}
                            </div>
                            <h3 class="text-2xl font-bold text-white mb-4">
                                {item.title}
                            </h3>
                            <p class="text-white/60 leading-relaxed">
                                {item.desc}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- The Form: High Impact Transition -->
    <section id="contact" class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <span
                    class="text-green-600 font-bold uppercase tracking-widest text-sm"
                    >Step 1 of 1</span
                >
                <h2
                    class="text-4xl md:text-6xl font-display font-black text-neutral-900 mt-2"
                >
                    Get Your Copy Instantly
                </h2>
                <p class="text-neutral-500 mt-4 text-lg">
                    Enter your details and receive the PDF via Email & WhatsApp.
                </p>
            </div>

            <div
                class="rounded-[3rem] overflow-hidden shadow-[0_50px_100px_-30px_rgba(0,0,0,0.15)] border border-neutral-100"
            >
                <ContactForm accentGold="#16a34a" />
            </div>
        </div>
    </section>

    <!-- Trust Bar -->
    <section class="py-20 bg-neutral-50">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p
                class="text-neutral-400 font-medium uppercase tracking-[0.2em] mb-12 text-sm"
            >
                Recognized for Excellence in Arenal Real Estate
            </p>
            <div
                class="flex flex-wrap justify-center items-center gap-12 md:gap-24 opacity-40 grayscale hover:grayscale-0 transition-all"
            >
                <!-- Placeholders for partner/authority logos -->
                <span class="text-2xl font-black text-neutral-800"
                    >COSTA RICA INSIDER</span
                >
                <span class="text-2xl font-black text-neutral-800"
                    >ARENAL NEWS</span
                >
                <span class="text-2xl font-black text-neutral-800"
                    >INVEST CR</span
                >
            </div>
        </div>
    </section>
</Layout>

<style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;900&display=swap");

    h1,
    h2,
    h3,
    .font-display {
        font-family: "Outfit", sans-serif;
    }
</style>
