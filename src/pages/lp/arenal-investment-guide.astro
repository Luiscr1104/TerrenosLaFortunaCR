---
import Layout from "../../layouts/Layout.astro";
import ContactForm from "../../components/ContactForm.astro";
import { getAllProperties, formatPriceUSD } from "../../lib/properties";

const properties = getAllProperties().slice(0, 3);

const title =
    "Arenal Investment Guide | How Top Investors Target Double-Digit Returns";
const description =
    "Free guide on how international investors achieve double-digit returns in La Fortuna's real estate market. Legal frameworks, ROI strategies, and vetted opportunities.";

const coverImage =
    "https://imagedelivery.net/Lh5ivcu1Gl9SRBAdYRSP2g/32994a26-b26b-450d-4c7f-f3ab849aee00/public";
---

<Layout title={title} description={description} noindex={true}>
    <style>
        .premium-gradient {
            background: linear-gradient(135deg, #052e14 0%, #0d4a22 100%);
        }
        .text-glow {
            text-shadow: 0 0 20px rgba(22, 163, 74, 0.3);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .floating {
            animation: float 6s ease-in-out infinite;
        }
        @keyframes float {
            0% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-20px);
            }
            100% {
                transform: translateY(0px);
            }
        }
    </style>

    <!-- Hero Section: Softer Claims for Ads -->
    <section
        class="relative min-h-[85vh] flex items-center overflow-hidden premium-gradient pt-20"
    >
        <!-- Animated background accents -->
        <div
            class="absolute top-0 right-0 w-[500px] h-[500px] bg-green-500/10 rounded-full blur-[120px] -mr-64 -mt-64"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-yellow-500/5 rounded-full blur-[100px] -ml-48 -mb-48"
        >
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-12">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <!-- Left Content -->
                <div
                    class="animate-in fade-in slide-in-from-left duration-1000"
                >
                    <div
                        class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-green-400 text-sm font-bold tracking-widest uppercase mb-8 backdrop-blur-md"
                    >
                        <span class="relative flex h-2 w-2">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
                            ></span>
                            <span
                                class="relative inline-flex rounded-full h-2 w-2 bg-green-500"
                            ></span>
                        </span>
                        Free Investment Guide
                    </div>

                    <h1
                        class="text-4xl md:text-6xl font-display font-black text-white mb-8 leading-[1.1] text-glow"
                    >
                        How Top Investors <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-200"
                            >Target Double-Digit Returns</span
                        > in the Arenal Market
                    </h1>

                    <p
                        class="text-xl md:text-2xl text-white/80 mb-10 leading-relaxed font-light"
                    >
                        Learn the proven strategies international investors use
                        to identify high-yield land and properties in <span
                            class="text-white font-medium italic underline decoration-green-500/50"
                            >La Fortuna, Costa Rica</span
                        >.
                    </p>

                    <!-- Simple Trust Bullets -->
                    <div
                        class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-6 mb-8"
                    >
                        <ul class="space-y-3 text-white/90">
                            <li class="flex items-center gap-3">
                                <span class="text-green-400 text-xl">✔</span>
                                <span>Foreigners can legally own land</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <span class="text-green-400 text-xl">✔</span>
                                <span>No residency required</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <span class="text-green-400 text-xl">✔</span>
                                <span>Cash purchases welcome</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <span class="text-green-400 text-xl">✔</span>
                                <span>Secure remote closing available</span>
                            </li>
                        </ul>
                    </div>

                    <div class="flex items-center gap-4 text-white/60">
                        <div class="flex -space-x-3">
                            {
                                [1, 2, 3, 4].map((i) => (
                                    <div class="w-10 h-10 rounded-full border-2 border-green-900 bg-neutral-800 flex items-center justify-center">
                                        <img
                                            src={`https://i.pravatar.cc/100?u=${i}`}
                                            class="rounded-full w-full h-full object-cover"
                                        />
                                    </div>
                                ))
                            }
                        </div>
                        <span class="text-sm">Trusted by 500+ investors</span>
                    </div>
                </div>

                <!-- Right Content: The Visual Hook -->
                <div class="relative lg:block">
                    <div class="relative z-10 floating">
                        <img
                            src={coverImage}
                            alt="Arenal Investment Guide 2024"
                            class="w-full max-w-[480px] mx-auto rounded-[2rem] shadow-[0_50px_100px_-20px_rgba(0,0,0,0.6)] border-[12px] border-white/5"
                        />

                        <!-- Floating Achievement Badge -->
                        <div
                            class="absolute -bottom-10 -left-10 bg-white p-6 rounded-3xl shadow-2xl animate-in zoom-in duration-700 delay-500 hidden md:block"
                        >
                            <div
                                class="text-neutral-900 font-bold text-3xl mb-1"
                            >
                                100%
                            </div>
                            <div
                                class="text-neutral-500 text-xs uppercase tracking-tighter"
                            >
                                Legal Transparency
                            </div>
                        </div>
                    </div>

                    <!-- Decorative Background element -->
                    <div
                        class="absolute inset-0 bg-green-500/20 blur-[100px] scale-110 -z-10"
                    >
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- EARLY LEAD CAPTURE FORM -->
    <section id="early-contact" class="py-20 bg-white relative">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-12">
                <div
                    class="inline-flex items-center gap-2 bg-[#052E14]/5 text-[#052E14] px-5 py-2.5 rounded-full text-xs font-black uppercase tracking-widest mb-6 border border-[#052E14]/10"
                >
                    <span
                        class="flex h-2 w-2 rounded-full bg-[#D4AF37] animate-pulse"
                    ></span>
                    Instant Access
                </div>
                <h2
                    class="text-3xl md:text-5xl font-display font-black text-neutral-900 tracking-tight mb-4"
                >
                    Get Your Free Guide Now
                </h2>
                <p class="text-neutral-600 text-lg max-w-2xl mx-auto">
                    Enter your details below and we'll send the complete guide
                    to your email within 60 seconds.
                </p>
            </div>

            <div
                class="rounded-[2.5rem] overflow-hidden shadow-[0_50px_100px_-30px_rgba(0,0,0,0.15)] border border-neutral-100"
            >
                <ContactForm
                    accentGold="#D4AF37"
                    image="https://imagedelivery.net/Lh5ivcu1Gl9SRBAdYRSP2g/f41525fe-ec6d-4132-0f8f-df340eb94200/public"
                />
            </div>
        </div>
    </section>

    <!-- Inside the Guide: Simplified -->
    <section
        class="py-20 bg-neutral-50 relative overflow-hidden border-y border-neutral-100"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-16">
                <h2
                    class="text-3xl md:text-5xl font-display font-bold text-neutral-900 mb-4"
                >
                    What's Inside the Guide
                </h2>
                <div class="w-24 h-1 bg-[#D4AF37] mx-auto rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {
                    [
                        {
                            title: "The 2% Rule",
                            desc: "How to identify properties that generate enough rental income to cover all expenses and deliver positive cash flow.",
                            icon: "💎",
                        },
                        {
                            title: "ROI Hotspots",
                            desc: "Discover which specific areas in La Fortuna are experiencing the strongest appreciation in 2024-2025.",
                            icon: "📈",
                        },
                        {
                            title: "Legal Protection",
                            desc: "Step-by-step guide to safe remote purchases, title verification, and working with trusted local attorneys.",
                            icon: "🛡️",
                        },
                    ].map((item) => (
                        <div class="bg-white p-8 rounded-3xl hover:shadow-xl transition-shadow border border-neutral-100 group text-center">
                            <div class="text-5xl mb-6 group-hover:scale-110 transition-transform inline-block">
                                {item.icon}
                            </div>
                            <h3 class="text-2xl font-bold text-neutral-900 mb-4">
                                {item.title}
                            </h3>
                            <p class="text-neutral-600 leading-relaxed">
                                {item.desc}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Who This Is For / Not For -->
    <section class="py-20 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2
                    class="text-3xl md:text-5xl font-display font-bold text-neutral-900 mb-4"
                >
                    Is This Guide Right for You?
                </h2>
                <p class="text-neutral-600 text-lg max-w-2xl mx-auto">
                    This guide is designed for serious investors. Here's who
                    will benefit most:
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- This IS for -->
                <div
                    class="bg-green-50 border-2 border-green-200 rounded-3xl p-10"
                >
                    <div
                        class="inline-flex items-center gap-2 bg-green-600 text-white px-4 py-2 rounded-full text-sm font-bold mb-6"
                    >
                        ✓ This guide is for you if:
                    </div>
                    <ul class="space-y-4">
                        <li class="flex items-start gap-3">
                            <span class="text-green-600 text-xl mt-1">✓</span>
                            <span class="text-neutral-800 font-medium"
                                >You're investing <strong>$150k+</strong> in real
                                estate</span
                            >
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-green-600 text-xl mt-1">✓</span>
                            <span class="text-neutral-800 font-medium"
                                >You're buying with <strong>cash</strong> or have
                                financing secured</span
                            >
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-green-600 text-xl mt-1">✓</span>
                            <span class="text-neutral-800 font-medium"
                                >You want <strong>long-term appreciation</strong
                                > and rental income</span
                            >
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-green-600 text-xl mt-1">✓</span>
                            <span class="text-neutral-800 font-medium"
                                >You value <strong>legal certainty</strong> and professional
                                guidance</span
                            >
                        </li>
                    </ul>
                </div>

                <!-- This is NOT for -->
                <div class="bg-red-50 border-2 border-red-200 rounded-3xl p-10">
                    <div
                        class="inline-flex items-center gap-2 bg-red-600 text-white px-4 py-2 rounded-full text-sm font-bold mb-6"
                    >
                        ✕ This is NOT for:
                    </div>
                    <ul class="space-y-4">
                        <li class="flex items-start gap-3">
                            <span class="text-red-600 text-xl mt-1">✕</span>
                            <span class="text-neutral-600"
                                >Short-term flippers looking for quick profits</span
                            >
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-red-600 text-xl mt-1">✕</span>
                            <span class="text-neutral-600"
                                >Buyers looking for cheap land under $50k</span
                            >
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-red-600 text-xl mt-1">✕</span>
                            <span class="text-neutral-600"
                                >Financing-dependent purchases without
                                pre-approval</span
                            >
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-red-600 text-xl mt-1">✕</span>
                            <span class="text-neutral-600"
                                >Speculative investors without due diligence
                                interest</span
                            >
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Property Teaser: More Aggressive Blur -->
    <section
        class="py-20 bg-neutral-50 border-t border-neutral-100 relative overflow-hidden"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-16">
                <h2
                    class="text-3xl md:text-5xl font-display font-bold text-neutral-900 mb-4"
                >
                    Current Investment Opportunities
                </h2>
                <p class="text-neutral-600 text-lg max-w-2xl mx-auto mb-8">
                    Here's a preview of vetted properties featured in the
                    guide's case studies.
                </p>
                <div
                    class="inline-flex items-center gap-2 bg-[#D4AF37]/10 text-[#D4AF37] px-6 py-3 rounded-full text-sm font-bold border border-[#D4AF37]/20"
                >
                    🔒 Full inventory and pricing inside the guide
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {
                    properties.map((prop) => (
                        <div class="group relative rounded-3xl overflow-hidden border border-neutral-200 bg-white shadow-lg">
                            <div class="aspect-[4/3] relative overflow-hidden">
                                <img
                                    src={prop.images[0]}
                                    alt={prop.title}
                                    class="w-full h-full object-cover grayscale blur-[8px] scale-110"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-neutral-900 via-neutral-900/60 to-transparent" />
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <div class="text-center">
                                        <div class="text-white text-4xl mb-2">
                                            🔒
                                        </div>
                                        <p class="text-white font-bold text-sm">
                                            Details in Guide
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="p-6">
                                <h3 class="text-lg font-bold text-neutral-900 mb-2 blur-sm">
                                    {prop.title}
                                </h3>
                                <p class="text-neutral-400 text-sm mb-4 blur-sm">
                                    {prop.description || prop.features?.[0]}
                                </p>
                                <div class="text-center pt-4 border-t border-neutral-100">
                                    <span class="text-[#D4AF37] font-bold text-xs uppercase tracking-widest">
                                        Full Details Available Inside
                                    </span>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="text-center mt-12">
                <a
                    href="#early-contact"
                    class="inline-flex items-center gap-2 px-8 py-4 bg-[#D4AF37] hover:bg-[#D4AF37]/90 text-white rounded-2xl font-bold text-lg shadow-xl transition-all hover:scale-105 active:scale-95"
                >
                    Get Full Inventory List →
                </a>
            </div>
        </div>
    </section>

    <!-- Legal Pitfalls: Keep for Urgency -->
    <section
        class="py-20 bg-white border-y border-neutral-100 relative overflow-hidden"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div>
                    <span
                        class="text-red-600 font-bold uppercase tracking-[0.3em] text-xs mb-6 block"
                        >Critical Investor Alert</span
                    >
                    <h2
                        class="text-3xl md:text-5xl font-display font-bold text-neutral-900 mb-8 leading-tight"
                    >
                        3 Costly Mistakes Foreign Investors Make
                    </h2>
                    <p class="text-neutral-600 mb-10 leading-relaxed text-lg">
                        Costa Rica is a safe haven for real estate investment,
                        but these common errors can cost you thousands:
                    </p>
                    <ul class="space-y-6">
                        <li class="flex items-start gap-4">
                            <span class="text-red-600 font-bold mt-1 text-xl"
                                >✕</span
                            >
                            <p class="text-neutral-700 leading-relaxed">
                                Buying land without <span
                                    class="font-bold text-neutral-900 border-b-2 border-red-200"
                                    >verified water availability</span
                                > (No water = No building permit)
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-red-600 font-bold mt-1 text-xl"
                                >✕</span
                            >
                            <p class="text-neutral-700 leading-relaxed">
                                Using the <span
                                    class="font-bold text-neutral-900 border-b-2 border-red-200"
                                    >seller's attorney</span
                                > instead of hiring independent legal representation
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-red-600 font-bold mt-1 text-xl"
                                >✕</span
                            >
                            <p class="text-neutral-700 leading-relaxed">
                                Failing to verify <span
                                    class="font-bold text-neutral-900 border-b-2 border-red-200"
                                    >protected zone boundaries</span
                                > on jungle or waterfront properties
                            </p>
                        </li>
                    </ul>
                </div>
                <div
                    class="bg-neutral-50 p-12 rounded-[3rem] border border-neutral-200 relative overflow-hidden"
                >
                    <div
                        class="absolute -top-10 -right-10 w-40 h-40 bg-green-500/5 blur-3xl rounded-full"
                    >
                    </div>
                    <h3
                        class="text-2xl font-bold text-neutral-900 mb-6 italic leading-relaxed"
                    >
                        "I wish I had this guide when I started investing here
                        years ago..."
                    </h3>
                    <p class="text-neutral-600 mb-10 leading-relaxed">
                        Investing significant capital shouldn't be a gamble. We
                        created this guide to ensure every international buyer
                        has the same legal protection as local developers.
                    </p>
                    <div class="flex items-center gap-5">
                        <img
                            src="https://imagedelivery.net/Lh5ivcu1Gl9SRBAdYRSP2g/599c7451-ca37-4569-9b3f-08f73a92fd00/public"
                            class="w-14 h-14 rounded-full border-2 border-neutral-200"
                            alt="Luis Rodríguez"
                        />
                        <div>
                            <p
                                class="text-neutral-900 font-black tracking-tight"
                            >
                                Luis Rodríguez
                            </p>
                            <p
                                class="text-[#D4AF37] text-xs font-black uppercase tracking-widest"
                            >
                                Arenal Specialist
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Trust Signals Section -->
    <section class="py-20 bg-neutral-50 border-t border-neutral-100">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2
                    class="text-3xl md:text-4xl font-display font-bold text-neutral-900 mb-4"
                >
                    Why Trust BuyLandCR?
                </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="text-center">
                    <div
                        class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"
                    >
                        <span class="text-3xl">🇨🇷</span>
                    </div>
                    <h3 class="text-xl font-bold text-neutral-900 mb-2">
                        Based in Costa Rica
                    </h3>
                    <p class="text-neutral-600">
                        We live and work in La Fortuna, with deep local market
                        knowledge.
                    </p>
                </div>

                <div class="text-center">
                    <div
                        class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"
                    >
                        <span class="text-3xl">⚖️</span>
                    </div>
                    <h3 class="text-xl font-bold text-neutral-900 mb-2">
                        Local Legal Partners
                    </h3>
                    <p class="text-neutral-600">
                        Network of trusted attorneys and notaries for secure
                        transactions.
                    </p>
                </div>

                <div class="text-center">
                    <div
                        class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"
                    >
                        <span class="text-3xl">📊</span>
                    </div>
                    <h3 class="text-xl font-bold text-neutral-900 mb-2">
                        Years of Experience
                    </h3>
                    <p class="text-neutral-600">
                        Proven track record helping international investors
                        succeed.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Final CTA Form -->
    <section id="contact" class="py-24 bg-white relative">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-16">
                <div
                    class="inline-flex items-center gap-2 bg-[#052E14]/5 text-[#052E14] px-5 py-2.5 rounded-full text-xs font-black uppercase tracking-widest mb-8 border border-[#052E14]/10"
                >
                    <span
                        class="flex h-2 w-2 rounded-full bg-[#D4AF37] animate-pulse"
                    ></span>
                    Immediate Delivery
                </div>
                <h2
                    class="text-4xl md:text-6xl font-display font-black text-neutral-900 mt-2 tracking-tight"
                >
                    Ready to Start Investing?
                </h2>
                <p
                    class="text-neutral-500 mt-6 text-lg max-w-2xl mx-auto leading-relaxed"
                >
                    Get the complete <span class="font-bold text-neutral-900"
                        >investment guide</span
                    > and <span class="font-bold text-neutral-900"
                        >exclusive property list</span
                    > sent to your inbox in 60 seconds.
                </p>
            </div>

            <div
                class="rounded-[3rem] overflow-hidden shadow-[0_100px_150px_-50px_rgba(0,0,0,0.1)] border border-neutral-100"
            >
                <ContactForm
                    accentGold="#D4AF37"
                    image="https://imagedelivery.net/Lh5ivcu1Gl9SRBAdYRSP2g/f41525fe-ec6d-4132-0f8f-df340eb94200/public"
                />
            </div>
        </div>
    </section>
</Layout>

<style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;900&display=swap");

    h1,
    h2,
    h3,
    .font-display {
        font-family: "Outfit", sans-serif;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }
</style>
